# Obelo configuration
# Copy to .env and fill in the values for your server:  cp .env.example .env
# Blank optional values disable the related feature.

# ── Core (required) ─────────────────────────────────────────────────────────
# Password for the bundled Postgres container (docker-compose.yml)
POSTGRES_PASSWORD=
# Database and user names of the bundled Postgres. Set once on a new install; never change them
# later (the data stays under the old names). Installs from before 3.46.4 have neither line and
# use `vibetrack`: leave those alone.
POSTGRES_DB=obelo
POSTGRES_USER=obelo
# Use the same password here; "db" is the compose service name
DATABASE_URL=postgresql://obelo:<POSTGRES_PASSWORD>@db:5432/obelo
# Long random string, e.g. output of: openssl rand -hex 32
SESSION_SECRET=
# Public URL users reach Obelo at (used in links, OAuth callbacks, webhooks)
APP_URL=http://localhost:3001
PORT=3000
# Port Obelo is published on, on the host (docker-compose.yml); point your reverse proxy here.
# It can include a bind address: APP_PORT=127.0.0.1:3001 makes the app reachable only from
# the host itself, which is what you want when the reverse proxy or tunnel runs on the same machine.
APP_PORT=3001
# production: secure cookies + rate limits — requires HTTPS (a reverse proxy); you can't
# log in over plain http:// in this mode. Use development only for local testing.
NODE_ENV=production
# Public demo only: DEMO_MODE=true refuses calendar accounts and notification channels, so people who
# sign in to a shared demo account can't connect anything personal. Leave blank on your own server.
DEMO_MODE=
# Development only (ignored unless NODE_ENV=development): the username that POST /api/v1/auth/dev
# signs the apps in as, so they can be tested without SSO. Leave blank in production.
DEV_APP_LOGIN_USER=

# ── Optional core ───────────────────────────────────────────────────────────
# Key for locked-note encryption; falls back to SESSION_SECRET if blank.
# Set it once and never change it, or existing locked notes can't be decrypted.
NOTE_LOCK_SECRET=
# Key for stored calendar credentials (CalDAV passwords, Google tokens); falls back to
# SESSION_SECRET if blank. Setting it lets you rotate SESSION_SECRET without having to
# reconnect calendars. Existing credentials are re-encrypted with it on the next start.
CREDENTIALS_ENCRYPTION_KEY=
# Sign-in lifetime: you're signed out after this many hours without using the app
# (default 12), and in any case this many days after signing in (default 7)
SESSION_IDLE_HOURS=
SESSION_MAX_DAYS=
# How long the iOS app stays signed in, used for both limits above (default 90 days)
APP_SESSION_DAYS=
# debug | info | warn | error
LOG_LEVEL=info

# ── Uploaded files (note images, avatars) ───────────────────────────────────
# Where uploads are kept on the host. Blank = the "uploads" Docker volume on this server's
# disk (recommended; back it up with scripts/backup.sh). Set an absolute path to use a host
# folder instead, e.g. a NAS mount: /mnt/nas/obelo_userfiles
# The folder must be writable by UID 1001 (the app's user inside the container).
UPLOADS_DIR=
# Encrypts uploaded files at rest (AES-256-GCM), so the storage location only holds
# unreadable data. Strongly recommended when UPLOADS_DIR is a network share.
# Generate with: openssl rand -hex 32
# Set it once and keep it safe — changing or losing it makes existing uploads unreadable.
# After setting it on an existing install, encrypt older files once with:
#   docker compose exec app node scripts/encrypt-uploads.js
UPLOADS_ENCRYPTION_KEY=
# Path inside the container; only change this when running without Docker.
UPLOAD_PATH=

# ── AI (Chat + Capture) ─────────────────────────────────────────────────────
# Leave AI_PROVIDER blank to disable AI features.
#   anthropic          Claude — needs AI_API_KEY (console.anthropic.com)
#   openai             OpenAI — needs AI_API_KEY (platform.openai.com)
#   openai-compatible  Any server with an OpenAI-style API, including local/self-hosted
#                      models (Ollama, LM Studio, llama.cpp, vLLM, LocalAI) and gateways
#                      (OpenRouter, Groq, ...) — needs AI_BASE_URL; AI_API_KEY only if the
#                      server requires one
AI_PROVIDER=
AI_API_KEY=
# openai-compatible only. Examples:
#   Ollama:    http://192.168.1.50:11434/v1
#   LM Studio: http://192.168.1.50:1234/v1
# Obelo calls this from inside its container, so "localhost" means the container
# itself. For a model running on the Docker host use http://host.docker.internal:11434/v1
AI_BASE_URL=
# Model for AI Chat (answers questions over your data — use a capable model),
# e.g. claude-sonnet-5, gpt-5, llama3.1:8b
AI_CHAT_MODEL=
# Model for Capture (turns quick notes into tasks/reminders/etc. as JSON — a small, fast
# model is fine), e.g. claude-haiku-4-5. Defaults to AI_CHAT_MODEL if blank.
AI_CAPTURE_MODEL=
# Per-user daily AI Chat message limit
AI_CHAT_DAILY_LIMIT=50
# Seconds to wait for a response before giving up (raise for slow local hardware)
AI_TIMEOUT_SECONDS=120
# Local models: AI Chat sends a large block of your data with each question. Ollama's
# default context window is small and silently drops anything that doesn't fit, so raise
# it on the Ollama side (e.g. OLLAMA_CONTEXT_LENGTH=32768, or num_ctx in a Modelfile;
# LM Studio: "Context Length" in the model's load settings). If you can't, cap how much
# data is sent here (characters; roughly 4 per token). Blank = no cap.
AI_CHAT_MAX_CONTEXT_CHARS=

# ── Single sign-on (OpenID Connect) ───────────────────────────────────
# Optional. Without it, people sign in with a username and password (a new server shows a
# one-time page to create the first admin). With it, the login page also shows an SSO button.
# Any OpenID Connect provider that supports discovery works.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# (Older installs may still use AUTHENTIK_ISSUER, AUTHENTIK_CLIENT_ID, AUTHENTIK_CLIENT_SECRET and
# AUTHENTIK_REDIRECT_URI. They still work and log a warning; rename them when convenient.)

# ── Google Calendar sync ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: the token from Google's site-verification page (Search Console, or the OAuth consent
# screen's domain check). Added to every page as a <meta> tag. Leave blank if you don't need it.
GOOGLE_SITE_VERIFICATION=

# ── Push notifications ──────────────────────────────────────────────────────
# Dry run: when true, push and email are written to the log and not sent. Left blank, it is on
# unless NODE_ENV=production, so a development server can't message real people. The test buttons
# in Settings always send.
NOTIFICATIONS_DRY_RUN=
# Pushover (paid app, pushover.net): your application token; users add their own user key
PUSHOVER_APP_TOKEN=
# ntfy (free, open source, usually self-hosted — see README): public base URL of the server,
# e.g. https://ntfy.example.com. Users get a private topic in Settings → Notifications.
NTFY_URL=
# Only if your ntfy server requires authentication to publish (recommended; see README)
NTFY_TOKEN=

# Your Pushover user key: scripts/backup.sh sends you a push notification if a backup fails
BACKUP_ALERT_PUSHOVER_USER=

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
