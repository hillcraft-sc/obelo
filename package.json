{
  "name": "obelo",
  "version": "3.57.1",
  "description": "Self-hosted personal productivity hub",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "test": "bash scripts/test.sh",
    "dev": "nodemon src/app.js",
    "build:css": "tailwindcss -i tailwind.input.css -o public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i tailwind.input.css -o public/css/tailwind.css --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.1",
    "helmet": "^8.2.0",
    "ical-generator": "^11.0.0",
    "marked": "^18.0.5",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "node-ical": "^0.26.1",
    "nodemailer": "^10.5.0",
    "openai": "^6.49.0",
    "pg": "^8.22.0",
    "tsdav": "^2.3.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
