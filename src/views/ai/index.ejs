<div class="flex flex-col h-[calc(100vh-11rem)] lg:h-[calc(100vh-4rem)] max-w-2xl mx-auto px-4 py-4">

  <!-- Header -->
  <div class="flex items-center justify-between mb-4 shrink-0">
    <%- include('../partials/page-heading', { heading: 'AI Chat', description: 'Ask anything about your tasks, notes, reminders or calendar.' }) %>
    <% if (messages.length > 0) { %>
      <form method="POST" action="/ai/clear">
        <button type="submit"
                class="text-xs px-3 py-1.5 rounded-lg bg-gray-800 hover:bg-gray-700 text-gray-500 hover:text-gray-300 border border-gray-700 transition-colors">
          Clear chat
        </button>
      </form>
    <% } %>
  </div>

  <% if (!locals.aiEnabled) { %>
    <div class="mb-4 px-4 py-3 rounded-lg bg-amber-950 border border-amber-800 text-amber-300 text-sm shrink-0">
      AI isn't configured on this server. The server admin can enable it by setting the <code>AI_*</code> variables in <code>.env</code>.
    </div>
  <% } %>

  <!-- Message thread -->
  <div id="chat-messages" class="flex-1 overflow-y-auto space-y-1 mb-4 scrollbar-thin">

    <% if (messages.length === 0) { %>
      <div id="chat-empty" class="flex flex-col items-center justify-center h-full text-center space-y-4 pb-16">
        <div class="w-12 h-12 rounded-2xl bg-indigo-900/50 border border-indigo-800 flex items-center justify-center text-2xl">✦</div>
        <div>
          <p class="text-gray-400 text-sm font-medium">Ask me about your data</p>
          <p class="text-gray-600 text-xs mt-1">Tasks, notes, reminders, calendar — all in context</p>
        </div>
        <div class="grid grid-cols-1 gap-2 w-full max-w-sm mt-2">
          <% [
            'What tasks are slipping this week?',
            'What did I flag for review?',
            'How have my steps been lately?',
            'What books am I tracking?',
          ].forEach(q => { %>
            <button onclick="fillPrompt(this.textContent)"
                    class="text-left text-xs px-3 py-2 rounded-lg bg-gray-900 border border-gray-800 text-gray-400 hover:text-white hover:border-gray-600 transition-colors">
              <%= q %>
            </button>
          <% }); %>
        </div>
      </div>
    <% } else { %>
      <% messages.forEach(m => { %>
        <% if (m.role === 'user') { %>
          <div class="flex justify-end mb-4">
            <div class="max-w-[80%] px-4 py-2.5 rounded-2xl rounded-tr-sm bg-indigo-600 text-white text-sm leading-relaxed">
              <%- m.content.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;').replace(/\n/g,'<br>') %>
            </div>
          </div>
        <% } else { %>
          <div class="flex justify-start mb-4">
            <div class="max-w-[85%] px-4 py-2.5 rounded-2xl rounded-tl-sm bg-gray-800 border border-gray-700 text-gray-100 text-sm leading-relaxed">
              <%- m.content.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;').replace(/\n/g,'<br>') %>
            </div>
          </div>
        <% } %>
      <% }); %>
    <% } %>

    <!-- Typing indicator (shown while waiting) -->
    <div id="typing-indicator" class="hidden flex justify-start mb-4">
      <div class="px-4 py-3 rounded-2xl rounded-tl-sm bg-gray-800 border border-gray-700">
        <div class="flex gap-1">
          <span class="w-2 h-2 bg-gray-500 rounded-full animate-bounce" style="animation-delay:0ms"></span>
          <span class="w-2 h-2 bg-gray-500 rounded-full animate-bounce" style="animation-delay:150ms"></span>
          <span class="w-2 h-2 bg-gray-500 rounded-full animate-bounce" style="animation-delay:300ms"></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Input -->
  <div class="shrink-0">
    <form id="chat-form"
          hx-post="/ai/message"
          hx-target="#chat-messages"
          hx-swap="beforeend"
          class="flex gap-2 items-end">
      <textarea name="message" id="chat-input" rows="1"
                placeholder="Ask anything…"
                class="flex-1 bg-gray-900 border border-gray-700 rounded-xl px-4 py-3 text-white text-sm
                       placeholder-gray-600 focus:outline-hidden focus:border-indigo-500 resize-none leading-relaxed
                       max-h-32 overflow-y-auto"></textarea>
      <button type="submit" id="send-btn"
              class="shrink-0 w-10 h-10 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white flex items-center justify-center transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.269 20.876L5.999 12zm0 0h7.5"/>
        </svg>
      </button>
    </form>
  </div>

</div>

<script>
const chatMessages = document.getElementById('chat-messages');
const chatInput    = document.getElementById('chat-input');
const chatForm     = document.getElementById('chat-form');
const typingIndicator = document.getElementById('typing-indicator');

// Auto-resize textarea
chatInput.addEventListener('input', function() {
  this.style.height = 'auto';
  this.style.height = Math.min(this.scrollHeight, 128) + 'px';
});

// Cmd+Return to send
chatInput.addEventListener('keydown', function(e) {
  if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
    e.preventDefault();
    chatForm.requestSubmit();
  }
});

// HTMX hooks
document.body.addEventListener('htmx:beforeRequest', function(e) {
  if (e.detail.elt !== chatForm) return;
  const empty = document.getElementById('chat-empty');
  if (empty) empty.remove();
  typingIndicator.classList.remove('hidden');
  chatMessages.scrollTop = chatMessages.scrollHeight;
  chatInput.value = '';
  chatInput.style.height = 'auto';
  document.getElementById('send-btn').disabled = true;
});

document.body.addEventListener('htmx:afterRequest', function(e) {
  if (e.detail.elt !== chatForm) return;
  typingIndicator.classList.add('hidden');
  document.getElementById('send-btn').disabled = false;
  chatMessages.scrollTop = chatMessages.scrollHeight;
  chatInput.focus();
});

// Scroll to bottom on load
chatMessages.scrollTop = chatMessages.scrollHeight;
chatInput.focus();

function fillPrompt(text) {
  chatInput.value = text;
  chatInput.focus();
}
</script>
