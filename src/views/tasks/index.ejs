<div class="max-w-3xl mx-auto">

  <!-- Header -->
  <div class="flex items-center justify-between gap-3 mb-5">
    <%- include('../partials/page-heading', { heading: 'Tasks', description: 'Everything you plan to do, from inbox to done.' }) %>
    <a href="/tasks/new?status=<%= view === 'today' ? 'today' : 'inbox' %>"
       class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      New task
    </a>
  </div>

  <!-- View tabs -->
  <%
    const tabs = [
      { key: 'inbox',     label: 'Inbox',     badge: counts.inbox },
      { key: 'today',     label: 'Today',     badge: counts.today },
      { key: 'upcoming',  label: 'Upcoming',  badge: null },
      { key: 'all',       label: 'All',       badge: null },
      { key: 'completed', label: 'Completed', badge: null },
      { key: 'archived',  label: 'Archived',  badge: null },
      { key: 'slipping',  label: 'Slipping',  badge: counts.slipping, warn: true },
    ];
  %>
  <%- include('../partials/tabs', { tabs: tabs.map(tab => ({
    href: '/tasks?view=' + tab.key + (filters.tag ? '&tag=' + encodeURIComponent(filters.tag) : ''),
    label: tab.label, active: view === tab.key, badge: tab.badge, warn: tab.warn,
  })) }) %>

  <!-- Search + tag filter -->
  <div class="flex gap-2 mb-4">
    <form action="/tasks" method="GET" class="flex-1 flex gap-2">
      <input type="hidden" name="view" value="<%= view %>" />
      <% if (filters.tag) { %><input type="hidden" name="tag" value="<%= filters.tag %>" /><% } %>
      <input type="search" name="search" value="<%= filters.search %>"
             placeholder="Search tasks..."
             class="flex-1 px-3.5 py-2 rounded-lg bg-gray-800 border border-gray-700 text-gray-100 placeholder-gray-600 text-sm
                    focus:outline-hidden focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
    </form>
  </div>

  <% if (tagList.length > 0) { %>
    <div class="flex flex-wrap gap-1.5 mb-4">
      <% tagList.forEach(tag => { %>
        <% const active = filters.tag === tag; %>
        <a href="/tasks?view=<%= view %><%= !active ? '&tag=' + encodeURIComponent(tag) : '' %>"
           class="px-2 py-0.5 rounded-full text-xs font-medium transition-colors
                  <%= active ? 'bg-indigo-600 text-white' : 'bg-gray-800 text-gray-500 hover:text-gray-300' %>">
          #<%= tag %>
        </a>
      <% }); %>
    </div>
  <% } %>

  <!-- Quick-add bar -->
  <% if (view !== 'completed' && view !== 'slipping' && view !== 'archived') { %>
    <form hx-post="/tasks"
          hx-target="#task-list"
          hx-swap="afterbegin"
          hx-on::after-request="this.reset()"
          class="flex gap-2 mb-4">
      <input type="hidden" name="status" value="<%= view === 'today' ? 'today' : 'inbox' %>" />
      <input type="text" name="title" placeholder="Quick-add a task and press Enter..."
             class="flex-1 px-3.5 py-2.5 rounded-lg bg-gray-800 border border-gray-700 text-gray-100 placeholder-gray-600 text-sm
                    focus:outline-hidden focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
      <button type="submit"
              class="px-4 py-2.5 rounded-lg bg-gray-700 hover:bg-gray-600 text-gray-200 text-sm font-medium transition-colors">
        Add
      </button>
    </form>
  <% } %>

  <!-- Slipping banner -->
  <% if (view === 'slipping' && tasks.length > 0) { %>
    <div class="mb-4 px-4 py-3 rounded-lg bg-amber-950/50 border border-amber-900 text-amber-300 text-sm">
      These tasks haven't been updated in <%= 7 %> days. Give them some attention or archive them.
    </div>
  <% } %>

  <!-- Bulk form + task list -->
  <form id="bulk-form" action="/tasks/bulk" method="POST" class="inline"></form>

  <div class="rounded-xl bg-gray-900 border border-gray-800 overflow-hidden">

    <!-- Bulk action bar (hidden until checkboxes selected) -->
    <div id="bulk-bar" class="hidden flex items-center gap-3 px-4 py-2.5 bg-indigo-950/50 border-b border-indigo-900">
      <span class="text-xs text-indigo-300 font-medium flex-1"><span id="bulk-count">0</span> selected</span>
      <select name="action" form="bulk-form"
              class="text-xs bg-gray-800 border border-gray-700 text-gray-200 rounded-lg px-2 py-1 focus:outline-hidden focus:ring-1 focus:ring-indigo-500">
        <option value="complete">Mark complete</option>
        <% if (view === 'archived') { %>
          <option value="restore">Restore to inbox</option>
        <% } else { %>
          <option value="archive">Archive</option>
        <% } %>
        <option value="high">Priority: High</option>
        <option value="medium">Priority: Medium</option>
        <option value="low">Priority: Low</option>
        <option value="none">Priority: None</option>
      </select>
      <button type="submit" form="bulk-form"
              class="px-3 py-1 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-medium transition-colors">
        Apply
      </button>
      <button type="button" onclick="clearSelection()"
              class="text-gray-500 hover:text-gray-300 text-xs transition-colors">Cancel</button>
    </div>

    <!-- Task list -->
    <div id="task-list">
      <% if (tasks.length === 0) { %>
        <%
          const newTaskHref = '/tasks/new?status=' + (view === 'today' ? 'today' : 'inbox');
          const filtered = filters.search || filters.tag;
          const emptyMsg = filtered ? 'No tasks match this filter.'
            : ({ inbox: 'No inbox tasks yet.', today: 'Nothing due today.', upcoming: 'Nothing due in the next 7 days.',
                 completed: 'No completed tasks yet.', archived: 'No archived tasks yet.', slipping: 'No slipping tasks.' })[view]
              || 'No tasks yet.';
          const emptyAction = filtered ? { label: 'Clear filter', href: '/tasks?view=' + view }
            : (['completed', 'archived', 'slipping'].includes(view) ? null : { label: 'New task', href: newTaskHref });
        %>
        <%- include('../partials/empty-state', { message: emptyMsg, action: emptyAction }) %>
      <% } %>


      <% if (view === 'upcoming') { %>
        <%
          // Group by date using ISO date string (UTC) as key
          const grouped = {};
          tasks.forEach(t => {
            const key = t.dueDate ? t.dueDate.toISOString().split('T')[0] : 'No date';
            if (!grouped[key]) grouped[key] = [];
            grouped[key].push(t);
          });
        %>
        <% Object.entries(grouped).forEach(([dateStr, group]) => { %>
          <div class="px-4 py-2 bg-gray-800/50 border-b border-gray-800">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
              <%
                if (dateStr === 'No date') { %><%= 'No date' %><% } else {
                const diff = Math.round((new Date(dateStr + 'T00:00:00.000Z') - new Date(todayLocal + 'T00:00:00.000Z')) / 86400000);
              %>
              <%= diff === 0 ? 'Today' : diff === 1 ? 'Tomorrow' : new Date(dateStr + 'T00:00:00.000Z').toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric', timeZone: 'UTC' }) %>
              <% } %>
            </span>
          </div>
          <% group.forEach(task => { %>
            <%- include('_row', { task, PRIORITY_DOT, PRIORITY_RING, STATUS_CLS, STATUS_LABELS, STATUSES, statusSelectHtml, todayLocal, nowHHMM }) %>
          <% }); %>
        <% }); %>
      <% } else { %>
        <% tasks.forEach(task => { %>
          <%- include('_row', { task, PRIORITY_DOT, PRIORITY_RING, STATUS_CLS, STATUS_LABELS, STATUSES, statusSelectHtml, todayLocal, nowHHMM }) %>
        <% }); %>
      <% } %>
    </div>
  </div>

  <p class="text-xs text-gray-700 mt-2 text-right"><%= tasks.length %> task<%= tasks.length !== 1 ? 's' : '' %></p>
</div>

<script>
  // Bulk selection
  const checkboxes = () => document.querySelectorAll('#task-list input[type="checkbox"]');
  const bulkBar = document.getElementById('bulk-bar');
  const bulkCount = document.getElementById('bulk-count');

  function updateBulkBar() {
    const checked = [...checkboxes()].filter(c => c.checked);
    if (checked.length > 0) {
      bulkBar.classList.remove('hidden');
      bulkCount.textContent = checked.length;
    } else {
      bulkBar.classList.add('hidden');
    }
  }

  function clearSelection() {
    checkboxes().forEach(c => c.checked = false);
    updateBulkBar();
  }

  document.addEventListener('change', (e) => {
    if (e.target.type === 'checkbox' && e.target.form?.id === 'bulk-form') updateBulkBar();
  });

  // Mobile swipe: right = complete, left = delete
  (function () {
    var list = document.getElementById('task-list');
    if (!list || !('ontouchstart' in window)) return;

    var THRESHOLD = 72;
    var startX, startY, activeRow, activeContent, locked;

    list.addEventListener('touchstart', function (e) {
      var row = e.target.closest('.task-row[data-task-id]');
      if (!row || !row.querySelector('.swipe-hint-r')) return;
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      activeRow = row;
      activeContent = row.querySelector('.swipe-content');
      locked = false;
    }, { passive: true });

    list.addEventListener('touchmove', function (e) {
      if (!activeRow || locked) return;
      var dx = e.touches[0].clientX - startX;
      var dy = e.touches[0].clientY - startY;
      if (Math.abs(dy) > Math.abs(dx) + 8) { locked = true; activeRow = null; return; }
      if (Math.abs(dx) < 6) return;
      e.preventDefault();
      activeContent.style.transform = 'translateX(' + dx + 'px)';
      activeContent.style.transition = 'none';
      var ratio = Math.min(1, Math.abs(dx) / THRESHOLD);
      activeRow.querySelector('.swipe-hint-r').style.opacity = dx > 0 ? ratio : 0;
      activeRow.querySelector('.swipe-hint-l').style.opacity = dx < 0 ? ratio : 0;
    }, { passive: false });

    list.addEventListener('touchend', function (e) {
      if (!activeRow || locked) { activeRow = null; return; }
      var dx = e.changedTouches[0].clientX - startX;
      var row = activeRow;
      var taskId = row.dataset.taskId;
      activeRow = null;
      if (dx > THRESHOLD) swipeComplete(row, taskId);
      else if (dx < -THRESHOLD) swipeDelete(row, taskId);
      else snapBack(row);
    }, { passive: true });

    function snapBack(row) {
      var c = row.querySelector('.swipe-content');
      c.style.transform = 'translateX(0)';
      c.style.transition = 'transform .25s ease';
      row.querySelector('.swipe-hint-r').style.opacity = 0;
      row.querySelector('.swipe-hint-l').style.opacity = 0;
    }

    function animateOut(row, dir) {
      var c = row.querySelector('.swipe-content');
      c.style.transform = 'translateX(' + (dir === 'r' ? '110%' : '-110%') + ')';
      c.style.transition = 'transform .22s ease';
      setTimeout(function () {
        var h = row.offsetHeight;
        row.style.height = h + 'px';
        row.style.overflow = 'hidden';
        row.style.transition = 'height .18s ease, opacity .18s ease';
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            row.style.height = '0';
            row.style.opacity = '0';
          });
        });
        setTimeout(function () { row.remove(); }, 200);
      }, 230);
    }

    function swipeComplete(row, id) {
      animateOut(row, 'r');
      fetch('/tasks/' + id + '/complete', { method: 'POST' });
    }

    function swipeDelete(row, id) {
      animateOut(row, 'l');
      fetch('/tasks/' + id + '/delete', { method: 'POST' });
    }
  })();
</script>
