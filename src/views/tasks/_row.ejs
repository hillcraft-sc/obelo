<%
  const due = task.dueDate ? new Date(task.dueDate) : null;
  const _dueUTC = due ? `${due.getUTCFullYear()}-${String(due.getUTCMonth()+1).padStart(2,'0')}-${String(due.getUTCDate()).padStart(2,'0')}` : null;
  const _timePast = task.dueTime ? task.dueTime < nowHHMM : false;
  const overdue = due && task.status !== 'done' && (_dueUTC < todayLocal || (_dueUTC === todayLocal && _timePast));
  const _isToday = due && _dueUTC === todayLocal && !overdue;
  const dueCls = overdue ? 'text-red-400' : _isToday ? 'text-green-400' : 'text-gray-600';
  const dueStr = due ? due.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }) : '';
  const ring = PRIORITY_RING[task.priority] || PRIORITY_RING.none;
%>
<div class="task-row relative overflow-hidden border-b border-gray-800 last:border-0" id="task-<%= task.id %>" data-task-id="<%= task.id %>">

  <% if (task.status !== 'done') { %>
  <div class="swipe-hint-r absolute inset-0 flex items-center gap-2 pl-5 bg-green-700" style="opacity:0">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-white shrink-0">
      <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z" clip-rule="evenodd"/>
    </svg>
    <span class="text-sm font-semibold text-white">Complete</span>
  </div>
  <div class="swipe-hint-l absolute inset-0 flex items-center justify-end gap-2 pr-5 bg-red-700" style="opacity:0">
    <span class="text-sm font-semibold text-white">Delete</span>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-white shrink-0">
      <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
    </svg>
  </div>
  <% } %>

  <div class="swipe-content flex items-center gap-3 px-4 py-3 hover:bg-gray-800/30 group bg-gray-900 relative">
    <input type="checkbox" name="ids" value="<%= task.id %>" form="bulk-form"
           class="w-4 h-4 rounded border-gray-600 bg-gray-700 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-gray-900 shrink-0" />

    <% if (task.status === 'done') { %>
      <button hx-post="/tasks/<%= task.id %>/restore" hx-target="#task-<%= task.id %>" hx-swap="outerHTML"
              class="w-5 h-5 rounded-full border-2 border-green-500 bg-green-500/20 shrink-0 flex items-center justify-center transition-colors hover:bg-red-500/20 hover:border-red-500"
              title="Restore to inbox">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3 text-green-400">
          <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z" clip-rule="evenodd"/>
        </svg>
      </button>
    <% } else { %>
      <button hx-post="/tasks/<%= task.id %>/complete" hx-target="#task-<%= task.id %>" hx-swap="outerHTML"
              class="w-5 h-5 rounded-full border-2 <%= ring %> hover:bg-green-500/20 hover:border-green-500 shrink-0 transition-colors"
              title="Mark complete"></button>
    <% } %>

    <%- PRIORITY_ICON[task.priority] || PRIORITY_ICON.none %>

    <a href="/tasks/<%= task.id %>"
       class="flex-1 min-w-0 text-sm hover:text-white truncate transition-colors
              <%= task.status === 'done' ? 'line-through text-gray-600' : 'text-gray-200' %>">
      <%= task.title %>
    </a>

    <% if (due) { %>
      <span class="text-xs shrink-0 <%= dueCls %>"><%= dueStr %></span>
    <% } %>

    <% task.tags.slice(0, 2).forEach(tag => { %>
      <span class="hidden sm:inline px-1.5 py-0.5 rounded text-[10px] bg-gray-800 text-gray-600">#<%= tag %></span>
    <% }); %>

    <%- statusSelectHtml(task.id, task.status) %>

    <a href="/tasks/<%= task.id %>/edit"
       class="opacity-0 group-hover:opacity-100 text-gray-600 hover:text-gray-300 transition-all shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
      </svg>
    </a>
  </div>
</div>
