<div class="max-w-2xl mx-auto py-6 px-4">

  <!-- Back -->
  <a href="/routines" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-300 mb-6 transition-colors">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
    </svg>
    Routines
  </a>

  <!-- Card -->
  <div class="bg-gray-900 rounded-xl border border-gray-800 overflow-hidden mb-6">

    <!-- Header -->
    <div class="px-6 pt-6 pb-4 border-b border-gray-800">
      <div class="flex items-start justify-between gap-4">
        <h1 class="text-xl font-semibold text-white leading-snug <%= !routine.active ? 'text-gray-500' : '' %>">
          <%= routine.title %>
          <% if (!routine.active) { %><span class="ml-2 text-xs font-normal px-2 py-0.5 rounded-full bg-gray-800 text-gray-500">archived</span><% } %>
        </h1>
        <div class="flex gap-2 shrink-0">
          <a href="/routines/<%= routine.id %>/edit"
             class="px-3 py-1.5 rounded-lg bg-gray-800 hover:bg-gray-700 text-sm text-gray-300 hover:text-white border border-gray-700 transition-colors">
            Edit
          </a>
          <form method="POST" action="/routines/<%= routine.id %>/archive">
            <button type="submit"
                    class="px-3 py-1.5 rounded-lg bg-gray-800 hover:bg-gray-700 text-sm text-gray-500 hover:text-gray-300 border border-gray-700 transition-colors">
              <%= routine.active ? 'Archive' : 'Restore' %>
            </button>
          </form>
          <form method="POST" action="/routines/<%= routine.id %>/delete"
                onsubmit="return confirm('Delete this routine and all its history?')">
            <button type="submit"
                    class="px-3 py-1.5 rounded-lg bg-gray-800 hover:bg-red-950 text-sm text-gray-500 hover:text-red-400 border border-gray-700 transition-colors">
              Delete
            </button>
          </form>
        </div>
      </div>

      <% if (routine.description) { %>
        <p class="mt-2 text-sm text-gray-500"><%= routine.description %></p>
      <% } %>

      <!-- Meta chips -->
      <div class="mt-3 flex flex-wrap gap-2">
        <span class="px-2 py-0.5 rounded-full bg-gray-800 text-gray-400 text-xs border border-gray-700">
          <%= TIME_LABELS[routine.timeOfDay] || routine.timeOfDay %>
        </span>
        <span class="px-2 py-0.5 rounded-full bg-gray-800 text-gray-400 text-xs border border-gray-700">
          <%= FREQ_LABELS[routine.frequency] || routine.frequency %>
          <% if ((routine.frequency === 'weekly' || routine.frequency === 'custom') && routine.scheduleDays.length) { %>
            · <%= routine.scheduleDays.join(', ') %>
          <% } %>
        </span>
        <% if (routine.specificTime) { %>
          <span class="px-2 py-0.5 rounded-full bg-gray-800 text-gray-400 text-xs border border-gray-700">
            <%= routine.specificTime %>
            <% if (routine.notify) { %>🔔<% } %>
          </span>
        <% } %>
        <% if (routine.durationDays) { %>
          <span class="px-2 py-0.5 rounded-full bg-indigo-950 text-indigo-300 text-xs border border-indigo-800">
            <%= totalCompletions %>/<%= routine.durationDays %> days
          </span>
        <% } %>
        <% (routine.tags || []).forEach(tag => { %>
          <span class="px-2 py-0.5 rounded-full bg-gray-800 text-gray-400 text-xs border border-gray-700">#<%= tag %></span>
        <% }); %>
      </div>
    </div>

    <!-- Streak stats -->
    <div class="grid grid-cols-3 divide-x divide-gray-800 border-b border-gray-800">
      <div class="px-4 py-4 text-center">
        <div class="text-2xl font-bold text-amber-400"><%= routine.streakCurrent %></div>
        <div class="text-xs text-gray-600 mt-0.5">Current streak</div>
      </div>
      <div class="px-4 py-4 text-center">
        <div class="text-2xl font-bold text-gray-300"><%= routine.streakBest %></div>
        <div class="text-xs text-gray-600 mt-0.5">Best streak</div>
      </div>
      <div class="px-4 py-4 text-center">
        <div class="text-2xl font-bold text-gray-300"><%= totalCompletions %></div>
        <div class="text-xs text-gray-600 mt-0.5">Total completions</div>
      </div>
    </div>

    <!-- Today action -->
    <% if (routine.active && isDueToday) { %>
      <div class="px-6 py-4 border-b border-gray-800">
        <button id="complete-btn-<%= routine.id %>"
                hx-post="/routines/<%= routine.id %>/complete"
                hx-target="#routine-<%= routine.id %>-card"
                hx-swap="outerHTML"
                class="flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-colors
                       <%= completedToday
                         ? 'bg-green-500/10 text-green-400 border border-green-800 hover:bg-red-500/10 hover:text-red-400 hover:border-red-800'
                         : 'bg-gray-800 hover:bg-green-600/20 text-gray-300 hover:text-green-400 border border-gray-700 hover:border-green-700' %>">
          <% if (completedToday) { %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
              <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z" clip-rule="evenodd"/>
            </svg>
            Done today — click to undo
          <% } else { %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Mark done for today
          <% } %>
        </button>
      </div>
    <% } %>

    <!-- Heatmap -->
    <div class="px-6 py-5">
      <div class="text-xs font-medium text-gray-500 mb-3">Last 12 weeks</div>
      <div class="flex gap-1">
        <% heatmap.forEach(week => { %>
          <div class="flex flex-col gap-1">
            <% week.forEach(cell => { %>
              <div class="w-3 h-3 rounded-sm transition-colors
                          <%= cell.isFuture ? 'bg-transparent' : cell.completed ? 'bg-green-500' : cell.notApplicable ? 'bg-gray-800/30' : 'bg-gray-800' %>"
                   title="<%= cell.label %><%= cell.completed ? ' ✓' : cell.notApplicable ? ' —' : '' %>"></div>
            <% }); %>
          </div>
        <% }); %>
      </div>
      <div class="flex justify-between mt-2 text-[10px] text-gray-700">
        <span><%= heatmap[0]?.[0]?.label || '' %></span>
        <span>Today</span>
      </div>
    </div>

    <!-- Weekly bar chart -->
    <div class="px-6 pb-5 border-t border-gray-800 pt-4">
      <div class="text-xs font-medium text-gray-500 mb-3">Weekly completion rate</div>
      <div class="flex items-end gap-1" style="height:64px;">
        <% weeklyStats.forEach(stat => { %>
          <div class="flex-1 rounded-t transition-all"
               style="height:<%= Math.max(stat.rate > 0 ? 3 : 0, Math.round(stat.rate * 0.64)) %>px;
                      background-color:<%= stat.rate >= 80 ? 'var(--st-green, #22c55e)' : stat.rate >= 50 ? '#6366f1' : stat.rate > 0 ? '#374151' : '#111827' %>;"
               title="<%= stat.label %>: <%= stat.completionCount %>/<%= stat.dayCount %> days (<%= stat.rate %>%)"></div>
        <% }); %>
      </div>
      <div class="flex justify-between mt-1 text-[10px] text-gray-700">
        <span><%= weeklyStats[0]?.label || '' %></span>
        <span>This week</span>
      </div>
    </div>
  </div>

  <!-- Creation date -->
  <div class="text-xs text-gray-700 px-1">
    Created <%= new Date(routine.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: currentUser.timezone || 'UTC' }) %>
  </div>
</div>

<% /* HTMX re-renders the show page complete button area — not full page */ %>
<script>
  // After HTMX swaps the row in list views, the show page complete button won't refresh.
  // The show page uses a full form POST for simplicity (button above links to HTMX POST).
  // To keep the button state accurate after toggling, we do a lightweight page reload
  // only on the show page's complete button via HTMX.
</script>
