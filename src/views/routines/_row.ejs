<%
  // Off-schedule routines can't be completed from a list row (matches the detail page);
  // an existing completion can still be undone.
  const canToggle = completedToday || isDueToday !== false;
%>
<div class="routine-row relative overflow-hidden border-b border-gray-800 last:border-0"
     id="routine-<%= routine.id %>">

  <% if (!completedToday && canToggle) { %>
  <!-- Right swipe hint: complete -->
  <div class="swipe-hint-r absolute inset-0 flex items-center gap-2 pl-5 bg-green-700" style="opacity:0">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-white shrink-0">
      <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z" clip-rule="evenodd"/>
    </svg>
    <span class="text-sm font-semibold text-white">Complete</span>
  </div>
  <% } %>

<div class="swipe-content relative flex items-center gap-3 px-4 py-3 hover:bg-gray-800/30 group bg-gray-900">

  <input type="checkbox" name="ids" value="<%= routine.id %>" form="bulk-form-routines"
         class="w-4 h-4 rounded border-gray-600 bg-gray-700 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-gray-900 shrink-0" />

  <!-- Completion toggle -->
  <% if (!canToggle) { %>
  <span class="w-5 h-5 rounded-md border-2 border-dashed border-gray-700 shrink-0 cursor-not-allowed"
        title="Not scheduled today"></span>
  <% } else { %>
  <button hx-post="/routines/<%= routine.id %>/complete"
          hx-target="#routine-<%= routine.id %>" hx-swap="outerHTML"
          class="w-5 h-5 rounded-md border-2 flex items-center justify-center shrink-0 transition-colors
                 <%= completedToday
                   ? 'bg-green-500/20 border-green-500 hover:border-red-400 hover:bg-transparent'
                   : 'border-gray-600 hover:border-green-500 hover:bg-green-500/10' %>"
          title="<%= completedToday ? 'Mark incomplete' : 'Mark complete' %>">
    <% if (completedToday) { %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3 text-green-400">
        <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z" clip-rule="evenodd"/>
      </svg>
    <% } %>
  </button>
  <% } %>

  <!-- Title -->
  <a href="/routines/<%= routine.id %>"
     class="flex-1 min-w-0 text-sm hover:text-white truncate transition-colors
            <%= completedToday ? 'line-through text-gray-500' : 'text-gray-200' %>">
    <%= routine.title %>
  </a>

  <!-- Streak -->
  <% if (routine.streakCurrent > 0) { %>
    <span class="flex items-center gap-1 text-xs shrink-0 <%= completedToday ? 'text-amber-400' : 'text-gray-600' %>"
          title="Current streak: <%= routine.streakCurrent %> days">
      🔥 <%= routine.streakCurrent %>
    </span>
  <% } %>

  <!-- Time-limited progress -->
  <% if (routine.durationDays && routine.active) {
       const daysDone = typeof completionCount !== 'undefined'
         ? completionCount
         : (routine._count && routine._count.completions) || 0;
  %>
    <span class="text-xs text-indigo-400 shrink-0" title="Day <%= daysDone %> of <%= routine.durationDays %>">
      Day <%= daysDone %>/<%= routine.durationDays %>
    </span>
  <% } %>

  <!-- Frequency -->
  <span class="hidden sm:inline text-xs text-gray-700 shrink-0">
    <%= FREQ_LABELS[routine.frequency] || routine.frequency %>
  </span>

  <!-- Edit -->
  <a href="/routines/<%= routine.id %>/edit"
     class="opacity-0 group-hover:opacity-100 text-gray-600 hover:text-gray-300 transition-all shrink-0">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
    </svg>
  </a>
</div>
</div>
