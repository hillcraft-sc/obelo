<%#
  Page heading (Phase 2 page pattern): page name and one line of muted description.
  The page name is hidden below lg, where the top bar already shows it.
  locals: heading, description
%>
<div class="min-w-0">
  <h1 class="hidden lg:block text-2xl font-bold text-white"><%= heading %></h1>
  <p class="text-sm text-gray-500 lg:mt-0.5"><%= description %></p>
</div>
