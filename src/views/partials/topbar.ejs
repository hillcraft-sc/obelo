<header class="lg:hidden flex items-center justify-between px-4 py-3 bg-gray-900 border-b border-gray-800 shrink-0">
  <div class="flex items-center">
    <span class="text-lg font-bold text-white tracking-tight">Obelo</span>
  </div>
  <div class="flex items-center gap-3">
    <span class="text-sm text-gray-400"><%= typeof title !== 'undefined' ? title : '' %></span>
    <button onclick="openSearch()" class="text-gray-500 hover:text-gray-300 transition-colors" title="Search">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
           stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
      </svg>
    </button>
    <div class="w-7 h-7 rounded-full bg-indigo-700 flex items-center justify-center text-xs font-semibold text-white">
      <%= currentUser.displayName.charAt(0).toUpperCase() %>
    </div>
  </div>
</header>
