<!-- Global Search Modal -->
<div id="search-modal" class="hidden fixed inset-0 z-50 flex items-start justify-center pt-16 px-4"
     role="dialog" aria-modal="true" aria-label="Global search">

  <!-- Backdrop -->
  <div id="search-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <!-- Panel -->
  <div class="relative w-full max-w-xl bg-gray-900 border border-gray-700 rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[70vh]">

    <!-- Input row -->
    <div class="flex items-center gap-3 px-4 py-3 border-b border-gray-800">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
           stroke="currentColor" class="w-4 h-4 text-gray-500 shrink-0">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
      </svg>
      <input id="global-search" type="text" placeholder="Search notes, tasks, lists, bookmarks…"
             autocomplete="off" spellcheck="false"
             class="flex-1 bg-transparent text-white text-sm placeholder-gray-500 focus:outline-hidden" />
      <kbd class="hidden sm:inline text-[10px] text-gray-600 bg-gray-800 border border-gray-700
                  rounded px-1.5 py-0.5 font-mono shrink-0">Esc</kbd>
    </div>

    <!-- Results -->
    <div id="search-results" class="flex-1 overflow-y-auto scrollbar-thin">

      <!-- Empty / hint state -->
      <div id="search-hint" class="px-4 py-6 text-center text-sm text-gray-600">
        Type at least 2 characters to search
      </div>

    </div>

    <!-- Footer hint -->
    <div class="px-4 py-2 border-t border-gray-800 flex items-center gap-4 text-[10px] text-gray-600">
      <span><kbd class="font-mono">↑↓</kbd> navigate</span>
      <span><kbd class="font-mono">↵</kbd> open</span>
      <span><kbd class="font-mono">Esc</kbd> close</span>
    </div>

  </div>
</div>

<script>
(function() {
  const modal     = document.getElementById('search-modal');
  const backdrop  = document.getElementById('search-backdrop');
  const input     = document.getElementById('global-search');
  const results   = document.getElementById('search-results');
  const hint      = document.getElementById('search-hint');

  let debounceTimer = null;
  let activeIdx = -1;
  let flatItems = [];

  // ── Open / Close ──────────────────────────────────────────────
  function open() {
    modal.classList.remove('hidden');
    input.value = '';
    resetResults();
    setTimeout(() => input.focus(), 30);
  }

  function close() {
    modal.classList.add('hidden');
    input.value = '';
    resetResults();
    activeIdx = -1;
    flatItems = [];
  }

  function resetResults() {
    results.innerHTML = '';
    hint.textContent = 'Type at least 2 characters to search';
    results.appendChild(hint);
    hint.classList.remove('hidden');
  }

  // ── Trigger open ─────────────────────────────────────────────
  // The layout already has a `/` keydown listener that calls focus() on this input.
  // We intercept focus to actually show the modal.
  input.addEventListener('focus', open);
  backdrop.addEventListener('click', close);

  // ── Search ────────────────────────────────────────────────────
  input.addEventListener('input', function() {
    clearTimeout(debounceTimer);
    const q = this.value.trim();
    if (q.length < 2) { resetResults(); return; }
    debounceTimer = setTimeout(() => doSearch(q), 200);
  });

  async function doSearch(q) {
    try {
      hint.textContent = 'Searching…';
      hint.classList.remove('hidden');

      const res  = await fetch('/search?q=' + encodeURIComponent(q));
      const data = await res.json();

      renderResults(data.results, q);
    } catch (e) {
      hint.textContent = 'Search failed — please try again.';
    }
  }

  // ── Render ────────────────────────────────────────────────────
  const TYPE_ICONS = {
    note:     '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>',
    task:     '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
    reminder: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/></svg>',
    routine:  '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>',
    calendar: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>',
    list:     '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>',
    bookmark: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.47 1.073-2.756 2.57-2.93a48.507 48.507 0 0111.186 0z"/></svg>',
  };

  // Results include text other people control (shared lists, sent bookmarks, synced
  // calendar invites), so everything is escaped before it becomes HTML.
  function escHtml(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function highlight(text, q) {
    if (!text) return '';
    const pattern = new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
    // split() with a capture group puts the matches at odd indexes
    return String(text).split(pattern).map((part, i) => i % 2
      ? `<mark class="bg-indigo-900 text-indigo-200 rounded px-0.5">${escHtml(part)}</mark>`
      : escHtml(part)
    ).join('');
  }

  function renderResults(groups, q) {
    results.innerHTML = '';
    flatItems = [];
    activeIdx = -1;

    if (!groups || groups.length === 0) {
      hint.textContent = 'No results for "' + q + '"';
      results.appendChild(hint);
      hint.classList.remove('hidden');
      return;
    }

    hint.classList.add('hidden');

    groups.forEach(group => {
      const groupEl = document.createElement('div');
      groupEl.className = 'px-3 pt-3 pb-1';

      const label = document.createElement('p');
      label.className = 'text-[10px] font-semibold text-gray-500 uppercase tracking-wider px-2 mb-1';
      label.textContent = group.group;
      groupEl.appendChild(label);

      group.items.forEach(item => {
        const idx = flatItems.length;
        flatItems.push(item);

        const a = document.createElement('a');
        a.href = item.url;
        a.dataset.idx = idx;
        a.className = 'flex items-center gap-3 px-2 py-2.5 rounded-lg text-sm hover:bg-gray-800 transition-colors cursor-pointer group result-item';
        a.innerHTML = `
          <span class="text-gray-500 shrink-0">${TYPE_ICONS[item.type] || ''}</span>
          <span class="flex-1 min-w-0">
            <span class="text-gray-100 font-medium truncate block">${highlight(item.title, q)}</span>
            ${item.subtitle ? `<span class="text-gray-500 text-xs truncate block">${escHtml(item.subtitle)}</span>` : ''}
          </span>`;
        a.addEventListener('click', close);
        groupEl.appendChild(a);
      });

      results.appendChild(groupEl);
    });

    if (flatItems.length > 0) setActive(0);
  }

  // ── Keyboard navigation ───────────────────────────────────────
  function setActive(idx) {
    const items = results.querySelectorAll('.result-item');
    items.forEach((el, i) => {
      if (i === idx) {
        el.classList.add('bg-gray-800');
        el.scrollIntoView({ block: 'nearest' });
      } else {
        el.classList.remove('bg-gray-800');
      }
    });
    activeIdx = idx;
  }

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { e.preventDefault(); close(); return; }

    const items = results.querySelectorAll('.result-item');
    if (!items.length) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(Math.min(activeIdx + 1, items.length - 1));
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(Math.max(activeIdx - 1, 0));
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (activeIdx >= 0 && flatItems[activeIdx]) {
        window.location.href = flatItems[activeIdx].url;
        close();
      }
    }
  });

  // Also close on Escape anywhere in the modal
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      close();
    }
  });

  // Expose open for the search icon button
  window.openSearch = open;
})();
</script>
