<%#
  Underlined section tabs (Phase 2 page pattern).
  locals: tabs = [{ href, label, active, badge?, warn?, badgeClass? }]
%>
<div class="flex gap-1 border-b border-gray-800 mb-4 overflow-x-auto">
  <% tabs.forEach(tab => { %>
    <a href="<%= tab.href %>"
       class="inline-flex items-center gap-1.5 px-4 py-2 text-sm whitespace-nowrap rounded-t-lg transition-colors
              <%= tab.active
                ? 'bg-gray-800 text-white border-b-2 border-indigo-500'
                : 'text-gray-500 hover:text-gray-300 hover:bg-gray-800/50' %>">
      <%= tab.label %>
      <% if (tab.badge) { %>
        <span class="<%= tab.badgeClass ? tab.badgeClass : tab.warn ? 'bg-red-500' : (tab.active ? 'bg-indigo-500' : 'bg-gray-700') %> text-white text-[10px] font-semibold px-1.5 py-0.5 rounded-full leading-none">
          <%= tab.badge %>
        </span>
      <% } %>
    </a>
  <% }); %>
</div>
