<div class="w-full max-w-sm mx-auto px-4">

  <div class="text-center mb-6">
    <img src="/icons/obelo-192.png" alt="Obelo" class="w-14 h-14 rounded-2xl mx-auto mb-4 object-cover" />
    <h1 class="text-2xl font-bold text-white">Obelo</h1>
    <p class="text-gray-400 text-sm mt-1">Your self-hosted personal productivity hub</p>
    <p class="text-gray-600 text-xs mt-3 leading-relaxed">
      Notes · Tasks · Reminders · Routines · Calendar · Lists · AI
    </p>
  </div>

  <div class="mb-6 px-4 py-3 rounded-lg bg-gray-900 border border-gray-800 text-xs text-gray-500 text-center leading-relaxed">
    A private, self-hosted app for managing your notes, tasks, routines,<br>calendar, and analytics — all in one place.
  </div>

  <% if (error) { %>
    <div class="mb-4 px-4 py-3 rounded-lg bg-red-950 border border-red-800 text-red-300 text-sm">
      <%= error %>
    </div>
  <% } %>

  <% if (notice) { %>
    <div class="mb-4 px-4 py-3 rounded-lg bg-green-950 border border-green-800 text-green-300 text-sm">
      <%= notice %>
    </div>
  <% } %>

  <% if (passwordEnabled) { %>
    <form method="POST" action="/auth/login" class="space-y-3 mb-4">
      <div>
        <label for="username" class="block text-xs text-gray-400 mb-1">Username or email</label>
        <input id="username" name="username" type="text" value="<%= username %>" required autofocus
               autocomplete="username" autocapitalize="none" spellcheck="false"
               class="w-full px-3 py-2 rounded-lg bg-gray-900 border border-gray-700 text-white text-sm focus:outline-none focus:border-indigo-500">
      </div>
      <div>
        <label for="password" class="block text-xs text-gray-400 mb-1">Password</label>
        <input id="password" name="password" type="password" required autocomplete="current-password"
               class="w-full px-3 py-2 rounded-lg bg-gray-900 border border-gray-700 text-white text-sm focus:outline-none focus:border-indigo-500">
      </div>
      <button type="submit"
              class="w-full py-2.5 px-4 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold transition-colors duration-150">
        Sign in
      </button>
    </form>
    <p class="text-center mb-4"><a href="/auth/code" class="text-xs text-indigo-400 hover:text-indigo-300">Have a setup code?</a></p>
    <% if (oidcEnabled) { %><p class="text-center text-xs text-gray-600 mb-4">or</p><% } %>
  <% } %>

  <% if (oidcEnabled) { %>
    <a href="/auth/oidc"
       class="flex items-center justify-center gap-3 w-full py-2.5 px-4 rounded-lg
              bg-gray-800 hover:bg-gray-700 border border-gray-700 hover:border-gray-600
              text-white text-sm font-semibold transition-colors duration-150">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-indigo-400 shrink-0" aria-hidden="true">
        <circle cx="8" cy="15" r="4" />
        <path d="M11 12l9-9M16 7l3 3M14 9l2 2" />
      </svg>
      Continue with single sign-on
    </a>
  <% } %>

</div>
