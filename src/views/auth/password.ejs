<div class="w-full max-w-sm mx-auto px-4">
  <div class="text-center mb-6">
    <img src="/icons/obelo-192.png" alt="Obelo" class="w-14 h-14 rounded-2xl mx-auto mb-4 object-cover" />
    <h1 class="text-2xl font-bold text-white"><%= valid && isNew ? 'Choose your password' : 'Set a new password' %></h1>
    <% if (valid && name) { %><p class="text-gray-400 text-sm mt-1">For <%= name %></p><% } %>
  </div>

  <% if (error) { %>
    <div class="mb-4 px-4 py-3 rounded-lg bg-red-950 border border-red-800 text-red-300 text-sm"><%= error %></div>
  <% } %>

  <% if (!valid) { %>
    <div class="px-4 py-3 rounded-lg bg-gray-900 border border-gray-800 text-sm text-gray-400 text-center">
      This link has expired or was already used. Ask your admin for a new one.
    </div>
    <p class="text-center mt-4"><a href="/auth/login" class="text-sm text-indigo-400 hover:text-indigo-300">Back to sign in</a></p>
  <% } else { %>
    <form method="POST" action="/auth/password/<%= token %>" class="space-y-3">
      <% const field = 'w-full px-3 py-2 rounded-lg bg-gray-900 border border-gray-700 text-white text-sm focus:outline-none focus:border-indigo-500'; %>
      <div>
        <label for="password" class="block text-xs text-gray-400 mb-1">Password <span class="text-gray-600">(at least <%= minLength %> characters)</span></label>
        <input id="password" name="password" type="password" required minlength="<%= minLength %>" autofocus autocomplete="new-password" class="<%= field %>">
      </div>
      <div>
        <label for="confirm" class="block text-xs text-gray-400 mb-1">Password again</label>
        <input id="confirm" name="confirm" type="password" required autocomplete="new-password" class="<%= field %>">
      </div>
      <button type="submit" class="w-full py-2.5 px-4 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold transition-colors duration-150">
        Save password
      </button>
    </form>
  <% } %>
</div>
