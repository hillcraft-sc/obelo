<div class="w-full max-w-xl mx-auto px-6 py-12 space-y-8">

  <!-- Logo + name -->
  <div class="text-center space-y-3">
    <img src="/icons/obelo-192.png" alt="Obelo"
         class="w-16 h-16 rounded-2xl mx-auto object-cover" />
    <h1 class="text-3xl font-bold text-white">Obelo</h1>
    <p class="text-gray-400 text-base">Self-hosted personal productivity hub</p>
  </div>

  <!-- Purpose — explicit description for Google verification -->
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-4 text-sm text-gray-300 leading-relaxed">
    <p>
      Obelo is a private, self-hosted web application that brings notes, tasks, reminders,
      routines, calendars, and lists together in one place — running on
      infrastructure you control, with no third-party data sharing.
    </p>
    <p>
      Obelo integrates with <strong class="text-white">Google Calendar</strong> to read
      and display your calendar events within the app, and to create new events on your behalf.
      This requires access to your Google Calendar data, which is stored locally on your
      self-hosted server and is never shared with third parties.
    </p>
    <p>
      Access is set by the server operator. Obelo is self-hosted, not a public service.
    </p>
  </div>

  <!-- Feature list -->
  <div>
    <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Features</h2>
    <div class="grid grid-cols-2 gap-2 text-sm">
      <% [
        ['Notes & Journal', 'Markdown notes, quotes, and journal entries'],
        ['Tasks', 'Inbox, priorities, and recurring tasks'],
        ['Reminders', 'Time-based with push notifications'],
        ['Routines', 'Daily habits with streak tracking'],
        ['Calendar', 'Apple CalDAV & Google Calendar sync'],
        ['Lists', 'Quick checklists for anything'],
        ['AI Chat', 'Ask questions about your own data'],
      ].forEach(([title, desc]) => { %>
        <div class="bg-gray-900 border border-gray-800 rounded-lg p-3">
          <p class="text-xs font-semibold text-white"><%= title %></p>
          <p class="text-xs text-gray-600 mt-0.5 leading-snug"><%= desc %></p>
        </div>
      <% }); %>
    </div>
  </div>

  <!-- Sign in -->
  <div class="text-center space-y-2">
    <a href="/auth/login"
       class="inline-block px-8 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-lg transition-colors">
      Sign in
    </a>
    <p class="text-xs text-gray-700">Self-hosted</p>
  </div>

  <!-- Legal -->
  <div class="border-t border-gray-800 pt-6 flex items-center justify-center gap-6 text-xs text-gray-600">
    <a href="/privacy" class="hover:text-gray-400 transition-colors">Privacy Policy</a>
    <a href="/terms" class="hover:text-gray-400 transition-colors">Terms of Service</a>
  </div>

</div>
