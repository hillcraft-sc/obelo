    html[data-theme^="ctp-"]:not([data-status-colors="tailwind"]) :is(.border-red-700, .border-red-800, .border-red-900, .border-red-900\/50, .hover\:border-red-700:hover, .hover\:border-red-800:hover, .hover\:border-red-900:hover) { border-color: var(--st-red-b) !important; }
    html[data-theme^="ctp-"]:not([data-status-colors="tailwind"]) :is(.border-amber-500) { border-color: var(--st-yellow) !important; }
    html[data-theme^="ctp-"]:not([data-status-colors="tailwind"]) :is(.border-amber-500\/20, .border-amber-500\/30, .border-amber-700, .border-amber-800, .border-amber-900, .border-amber-900\/50, .hover\:border-amber-900:hover) { border-color: var(--st-yellow-b) !important; }
    html[data-theme^="ctp-"]:not([data-status-colors="tailwind"]) :is(.text-blue-400) { color: var(--st-blue) !important; }
