    html[data-theme^="ctp-"]:not([data-status-colors="tailwind"]) :is(.hover\:text-amber-300:hover, .text-amber-100, .text-amber-200, .text-amber-300) { color: var(--st-yellow-l) !important; }
    /* Pastel fills take dark text, like the accent */
    html[data-theme^="ctp-"]:not([data-status-colors="tailwind"]) :is(.bg-amber-500, .bg-amber-600, .bg-amber-700, .bg-blue-500, .bg-blue-600, .bg-emerald-500, .bg-green-500, .bg-green-600, .bg-green-700, .bg-red-500, .bg-red-600, .bg-red-700, .bg-violet-500, .bg-yellow-400).text-white,
    html[data-theme^="ctp-"]:not([data-status-colors="tailwind"]) :is(.bg-amber-500, .bg-amber-600, .bg-amber-700, .bg-blue-500, .bg-blue-600, .bg-emerald-500, .bg-green-500, .bg-green-600, .bg-green-700, .bg-red-500, .bg-red-600, .bg-red-700, .bg-violet-500, .bg-yellow-400) .text-white { color: var(--st-on) !important; }

    /* ═══════════════════════════════════════════════════════════════════
       Shared override rules — apply to all themes via the variables above
       ═══════════════════════════════════════════════════════════════════ */

    /* Backgrounds */
    body                            { background-color: var(--bg-pg); }
    .bg-gray-950                    { background-color: var(--bg-pg) !important; }
    .bg-gray-900                    { background-color: var(--bg-sf) !important; }
    .bg-gray-800                    { background-color: var(--bg-el) !important; }
    .bg-gray-750                    { background-color: var(--bg-h1) !important; }
    .bg-gray-700                    { background-color: var(--bg-h2) !important; }
    .bg-gray-600                    { background-color: var(--bg-h3) !important; }
    .hover\:bg-gray-800:hover       { background-color: var(--bg-el) !important; }
    .hover\:bg-gray-750:hover       { background-color: var(--bg-h1) !important; }
    .hover\:bg-gray-700:hover       { background-color: var(--bg-h2) !important; }
    .hover\:bg-gray-600:hover       { background-color: var(--bg-h3) !important; }
    .bg-gray-800\/30                { background-color: rgba(var(--bg-el-r),var(--bg-el-g),var(--bg-el-b),.3) !important; }
    .bg-gray-800\/50                { background-color: rgba(var(--bg-el-r),var(--bg-el-g),var(--bg-el-b),.5) !important; }

    /* Borders */
    .border-gray-800                { border-color: var(--bd-1) !important; }
    .border-gray-700                { border-color: var(--bd-2) !important; }
    .border-gray-600                { border-color: var(--bd-3) !important; }

    /* Muted text */
    .text-gray-500                  { color: var(--tx-m)  !important; }
    .text-gray-600                  { color: var(--tx-x)  !important; }
    .text-gray-700                  { color: var(--tx-xx) !important; }
    .placeholder-gray-600::placeholder { color: var(--ph) !important; }

    /* Scrollbar */
    .scrollbar-thin::-webkit-scrollbar-thumb { background: var(--scrollbar); border-radius: 2px; }

    /* Accent — fill */
    .bg-indigo-600                  { background-color: var(--ac)   !important; }
    .bg-indigo-500                  { background-color: var(--ac-h) !important; }
    .bg-indigo-700                  { background-color: var(--ac-d) !important; }
    .bg-indigo-950                  { background-color: var(--ac-sf) !important; }
    .hover\:bg-indigo-600:hover     { background-color: var(--ac)   !important; }
    .hover\:bg-indigo-500:hover     { background-color: var(--ac-h) !important; }
    .bg-indigo-500\/20              { background-color: rgba(var(--ac-r),var(--ac-g),var(--ac-b),.2) !important; }
    .bg-indigo-600\/20              { background-color: rgba(var(--ac-r),var(--ac-g),var(--ac-b),.2) !important; }
    .bg-indigo-950\/50              { background-color: rgba(var(--ac-r),var(--ac-g),var(--ac-b),.1) !important; }

    /* Accent — text */
    .text-indigo-400                { color: var(--ac-t4) !important; }
    .text-indigo-300                { color: var(--ac-t3) !important; }
    .text-indigo-500                { color: var(--ac-t5) !important; }
    .text-indigo-600                { color: var(--ac-t6) !important; }

    /* Accent — border / focus ring */
    .border-indigo-500              { border-color: var(--ac-bd)  !important; }
    .border-indigo-900              { border-color: var(--ac-bd9) !important; }
    .focus\:border-indigo-500:focus { border-color: var(--ac-bd)  !important; }
    .accent-indigo-500              { accent-color: var(--ac)     !important; }

    /* ── Light-theme text overrides ─────────────────────────────────── */
    html:not(.dark) .text-white    { color: var(--tx-p)  !important; }
    html:not(.dark) .text-gray-100 { color: var(--tx-s1) !important; }
    html:not(.dark) .text-gray-200 { color: var(--tx-s2) !important; }
    html:not(.dark) .text-gray-300 { color: var(--tx-s3) !important; }
    html:not(.dark) .text-gray-400 { color: var(--tx-s4) !important; }

    /* Opacity-variant overrides for light themes (hardcoded rgba not caught by .bg-gray-900) */
    html:not(.dark) .bg-gray-900\/50  { background-color: rgba(var(--bg-el-r),var(--bg-el-g),var(--bg-el-b),.5) !important; }
    html:not(.dark) .border-gray-800\/60 { border-color: var(--bd-1) !important; }

    /* Restore white text on colored fill backgrounds */
    html:not(.dark) [class*="bg-indigo-"] .text-white,
    html:not(.dark) [class*="bg-indigo-"].text-white,
    html:not(.dark) [class*="bg-red-"] .text-white,
    html:not(.dark) [class*="bg-red-"].text-white,
    html:not(.dark) [class*="bg-emerald-"] .text-white,
    html:not(.dark) [class*="bg-emerald-"].text-white,
    html:not(.dark) [class*="bg-green-"] .text-white,
    html:not(.dark) [class*="bg-amber-"] .text-white { color: #ffffff !important; }

    /* Inputs on light bg */
    html:not(.dark) input[class*="bg-gray"],
    html:not(.dark) textarea[class*="bg-gray"],
    html:not(.dark) select[class*="bg-gray"] {
      background-color: var(--bg-sf) !important;
      color: var(--tx-p) !important;
    }

    /* ── Custom accent (CSS vars injected per-user via customAccentVars) */
    html[data-theme="custom"] .bg-indigo-600           { background-color: var(--ca)      !important; }
    html[data-theme="custom"] .bg-indigo-500           { background-color: var(--ca-hover) !important; }
