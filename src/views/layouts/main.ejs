    html[data-theme^="ctp-"]:not([data-status-colors="tailwind"]) :is(.text-violet-400) { color: var(--st-mauve) !important; }
    html[data-theme^="ctp-"]:not([data-status-colors="tailwind"]) :is(.hover\:text-red-400:hover, .text-red-400, .text-red-400\/80, .text-red-500, .text-red-600) { color: var(--st-red) !important; }
    html[data-theme^="ctp-"]:not([data-status-colors="tailwind"]) :is(.hover\:text-red-300:hover, .text-red-300) { color: var(--st-red-l) !important; }
