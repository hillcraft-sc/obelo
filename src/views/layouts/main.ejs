    html[data-theme^="ctp-"]:not([data-status-colors="tailwind"]) :is(.bg-amber-500, .bg-amber-600, .bg-amber-700, .bg-yellow-400, .hover\:bg-amber-700:hover) { background-color: var(--st-yellow) !important; }
