    html[data-theme="custom"] .hover\:bg-indigo-600:hover { background-color: var(--ca)   !important; }
    html[data-theme="custom"] .hover\:bg-indigo-500:hover { background-color: var(--ca-hover) !important; }
    html[data-theme="custom"] .text-indigo-400         { color: var(--ca-light) !important; }
    html[data-theme="custom"] .text-indigo-300         { color: var(--ca-muted) !important; }
    html[data-theme="custom"] .text-indigo-500         { color: var(--ca-hover) !important; }
    html[data-theme="custom"] .text-indigo-600         { color: var(--ca)       !important; }
    html[data-theme="custom"] .border-indigo-500       { border-color: var(--ca-hover)  !important; }
    html[data-theme="custom"] .accent-indigo-500       { accent-color: var(--ca)        !important; }
    html[data-theme="custom"] .bg-indigo-500\/20       { background-color: rgba(var(--ca-r),var(--ca-g),var(--ca-b),.2) !important; }
    html[data-theme="custom"] .bg-indigo-600\/20       { background-color: rgba(var(--ca-r),var(--ca-g),var(--ca-b),.2) !important; }
    html[data-theme="custom"] .bg-indigo-950\/50       { background-color: rgba(var(--ca-r),var(--ca-g),var(--ca-b),.1) !important; }
    html[data-theme="custom"] .focus\:border-indigo-500:focus { border-color: var(--ca-hover) !important; }
  </style>
  <% if (_theme === 'custom' && _customAccentVars) { %>
  <style>html[data-theme="custom"] { <%= _customAccentVars %> }</style>
  <% } %>
