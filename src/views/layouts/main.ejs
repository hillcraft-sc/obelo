            </div>
            <div class="flex items-center justify-between gap-4">
              <span class="text-sm text-gray-400">Checklist</span>
              <kbd class="inline-flex items-center px-1.5 py-0.5 rounded text-[11px] font-mono bg-gray-800 border border-gray-700 text-gray-300">toolbar</kbd>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    function openShortcuts()  { document.getElementById('shortcuts-modal').classList.remove('hidden'); }
    function closeShortcuts() { document.getElementById('shortcuts-modal').classList.add('hidden'); }

    // N opens a new note in the workspace when it's the default (Settings → Notes) or when you're in it
    async function newWorkspaceNote() {
      if (window.obeloFlush && !(await window.obeloFlush())) return; // save any unsaved edits first
      if (window.obeloMarkReload) window.obeloMarkReload();
      const f = document.createElement('form');
      f.method = 'POST';
      f.action = '/notes/workspace/new';
      const i = document.createElement('input');
      i.type = 'hidden'; i.name = 'folderId'; i.value = '';
      f.appendChild(i);
      const t = document.createElement('input');
      t.type = 'hidden'; t.name = '_csrf'; t.value = window.obeloCsrfToken;
      f.appendChild(t);
      document.body.appendChild(f);
      f.submit();
    }

    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { closeShortcuts(); return; }
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.key === 'd' || e.key === 'D') window.location.href = '/';
      if (e.key === 't' || e.key === 'T') window.location.href = '/tasks';
      if (e.key === 'n' || e.key === 'N') {
        newWorkspaceNote();
      }
      if (e.key === 'c' || e.key === 'C') window.location.href = '/capture';
      if (e.key === 'a' || e.key === 'A') window.location.href = '/analytics';
      if (e.key === 'b' || e.key === 'B') window.location.href = '/bookmarks';
      if (e.key === 'h' || e.key === 'H') window.location.href = '/help';
      if (e.key === ',') window.location.href = '/settings';
      if (e.key === '/') { e.preventDefault(); if (typeof openSearch === 'function') openSearch(); }
      if (e.key === '?') { e.preventDefault(); openShortcuts(); }
    });

    // Register service worker for PWA installability
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    }
  </script>
  <%- typeof script !== 'undefined' ? script : '' %>
</body>
</html>
