    html[data-theme^="ctp-"]:not([data-status-colors="tailwind"]) :is(.bg-emerald-500\/20, .bg-emerald-950, .bg-green-500\/10, .bg-green-500\/20, .bg-green-950) { background-color: var(--st-green-t) !important; }
    html[data-theme^="ctp-"]:not([data-status-colors="tailwind"]) :is(.bg-green-900, .hover\:bg-green-500\/10:hover, .hover\:bg-green-500\/20:hover, .hover\:bg-green-600\/20:hover, .hover\:bg-green-900:hover) { background-color: var(--st-green-t2) !important; }
    html[data-theme^="ctp-"]:not([data-status-colors="tailwind"]) :is(.bg-violet-500) { background-color: var(--st-mauve) !important; }
