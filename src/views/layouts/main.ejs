<!DOCTYPE html>
<html lang="en" class="<%= _isDark ? 'dark' : '' %>" data-theme="<%= _theme %>" data-status-colors="<%= typeof _statusColors !== 'undefined' ? _statusColors : 'catppuccin' %>">
<head>
  <meta charset="UTF-8" />
  <% if (locals.googleSiteVerification) { %><meta name="google-site-verification" content="<%= googleSiteVerification %>" /><% } %>
  <meta name="csrf-token" content="<%= csrfToken %>" />
  <script src="/js/csrf.js"></script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — Obelo' : 'Obelo' %></title>
  <script>
    // An installed web app already puts "Obelo - " in front of the window title; don't repeat it
    if (matchMedia('(display-mode: standalone)').matches || navigator.standalone) {
      document.title = document.title.replace(/ — Obelo$/, '');
    }
  </script>
  <meta name="theme-color" content="<%=
    _theme==='midnight' ? '#0a0b12' :
    _theme==='forest'   ? '#0d1a0f' :
    _theme==='mocha'    ? '#1c1410' :
    _theme==='sunset'   ? '#1a0f0f' :
    _theme==='amoled'   ? '#000000' :
    _theme==='breeze'   ? '#dce9f7' :
    _theme==='ctp-latte' ? '#dce0e8' :
    _theme==='ctp-frappe' ? '#292c3c' :
    _theme==='ctp-macchiato' ? '#1e2030' :
    _theme==='ctp-mocha' ? '#181825' :
    _isDark ? '#0f1117' : '#f8fafc'
  %>" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="<%= _isDark ? 'black-translucent' : 'default' %>" />
  <meta name="apple-mobile-web-app-title" content="Obelo" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/png" href="/icons/obelo-192.png" />
  <link rel="apple-touch-icon" href="/icons/obelo-180.png" />
  <link rel="stylesheet" href="/css/tailwind.css" />
  <script src="/js/htmx.min.js" defer></script>
  <style>
    [x-cloak] { display: none; }
    .scrollbar-thin::-webkit-scrollbar { width: 4px; }
    .scrollbar-thin::-webkit-scrollbar-track { background: transparent; }

    /* ═══════════════════════════════════════════════════════════════════
       THEME SYSTEM — CSS custom properties per theme, one shared
       override block maps Tailwind classes to those variables.
       ═══════════════════════════════════════════════════════════════════ */

    /* ── Dark (default) ─────────────────────────────────────────────── */
    html {
      color-scheme: dark;
      --bg-pg: #0f1117;  --bg-sf: #1a1d27;  --bg-el: #252836;
      --bg-h1: #2d3246;  --bg-h2: #353a56;  --bg-h3: #3e4366;
      --bg-el-r: 37;  --bg-el-g: 40;  --bg-el-b: 54;
      --bd-1: #2e3349;  --bd-2: #3a3f5c;  --bd-3: #474d6e;
      --tx-m: #6a7292;  --tx-x: #6a7292;  --tx-xx: #6a7292;
      --ph: #555d7c;  --scrollbar: #3a3f5c;
      --ac: #2563eb;  --ac-h: #3b7fff;  --ac-d: #1d4ed8;  --ac-sf: #0c1852;
      --ac-t4: #93bbff;  --ac-t3: #bdd3ff;  --ac-t5: #5b99ff;  --ac-t6: #2563eb;
      --ac-bd: #2563eb;  --ac-bd9: #1a3a8a;
      --ac-r: 37;  --ac-g: 99;  --ac-b: 235;
    }

    /* ── Midnight ────────────────────────────────────────────────────── */
    html[data-theme="midnight"] {
      --bg-pg: #0a0b12;  --bg-sf: #13151f;  --bg-el: #1d2030;
      --bg-h1: #252740;  --bg-h2: #2d2f50;  --bg-h3: #363960;
      --bg-el-r: 29;  --bg-el-g: 32;  --bg-el-b: 48;
      --bd-1: #272a3e;  --bd-2: #333652;  --bd-3: #404468;
      --tx-m: #676a88;  --tx-x: #676a88;  --tx-xx: #676a88;
      --ph: #4d5070;  --scrollbar: #333652;
      --ac: #7c3aed;  --ac-h: #9555ff;  --ac-d: #6d28d9;  --ac-sf: #2d1a5c;
      --ac-t4: #c4a8ff;  --ac-t3: #dac8ff;  --ac-t5: #a980ff;  --ac-t6: #7c3aed;
      --ac-bd: #7c3aed;  --ac-bd9: #4c1d95;
      --ac-r: 124;  --ac-g: 58;  --ac-b: 237;
    }

    /* ── Mocha ───────────────────────────────────────────────────────── */
    html[data-theme="mocha"] {
      --bg-pg: #1c1410;  --bg-sf: #261c15;  --bg-el: #33241b;
      --bg-h1: #3c2c22;  --bg-h2: #453329;  --bg-h3: #4e3b30;
      --bg-el-r: 51;  --bg-el-g: 36;  --bg-el-b: 27;
      --bd-1: #3d2b1f;  --bd-2: #4a3427;  --bd-3: #5a3f30;
      --tx-m: #8c6b45;  --tx-x: #8c6b45;  --tx-xx: #8c6b45;
      --ph: #6a4f33;  --scrollbar: #4a3427;
      --ac: #b45309;  --ac-h: #d06010;  --ac-d: #92400e;  --ac-sf: #451a03;
      --ac-t4: #f5b86e;  --ac-t3: #fcd28e;  --ac-t5: #e89040;  --ac-t6: #b45309;
      --ac-bd: #b45309;  --ac-bd9: #78350f;
      --ac-r: 180;  --ac-g: 83;  --ac-b: 9;
    }

    /* ── Forest ──────────────────────────────────────────────────────── */
    html[data-theme="forest"] {
      --bg-pg: #0d1a0f;  --bg-sf: #162419;  --bg-el: #1f3024;
      --bg-h1: #27382c;  --bg-h2: #2f4034;  --bg-h3: #37493c;
      --bg-el-r: 31;  --bg-el-g: 48;  --bg-el-b: 36;
      --bd-1: #28402d;  --bd-2: #334e38;  --bd-3: #3f5e45;
      --tx-m: #5e8062;  --tx-x: #5e8062;  --tx-xx: #5e8062;
      --ph: #476350;  --scrollbar: #334e38;
      --ac: #15803d;  --ac-h: #1a9e4c;  --ac-d: #166534;  --ac-sf: #052e16;
      --ac-t4: #6dd98a;  --ac-t3: #9de8b0;  --ac-t5: #3dc46a;  --ac-t6: #15803d;
      --ac-bd: #15803d;  --ac-bd9: #14532d;
      --ac-r: 21;  --ac-g: 128;  --ac-b: 61;
    }

    /* ── Sunset ──────────────────────────────────────────────────────── */
    html[data-theme="sunset"] {
      --bg-pg: #1a0f0f;  --bg-sf: #231616;  --bg-el: #2e1e1e;
      --bg-h1: #362525;  --bg-h2: #3e2c2c;  --bg-h3: #473333;
      --bg-el-r: 46;  --bg-el-g: 30;  --bg-el-b: 30;
      --bd-1: #3e2520;  --bd-2: #4c2f2a;  --bd-3: #5c3935;
      --tx-m: #8b6457;  --tx-x: #8b6457;  --tx-xx: #8b6457;
      --ph: #6a4b40;  --scrollbar: #4c2f2a;
      --ac: #b94528;  --ac-h: #d45530;  --ac-d: #9a3920;  --ac-sf: #3a1008;
      --ac-t4: #ffb38a;  --ac-t3: #ffd0b0;  --ac-t5: #f07050;  --ac-t6: #b94528;
      --ac-bd: #b94528;  --ac-bd9: #7f1d0f;
      --ac-r: 185;  --ac-g: 69;  --ac-b: 40;
    }

    /* ── AMOLED ─────────────────────────────────────────────────────── */
    html[data-theme="amoled"] {
      --bg-pg: #000000;  --bg-sf: #0d0d0d;  --bg-el: #141414;
      --bg-h1: #1a1a1a;  --bg-h2: #1f1f1f;  --bg-h3: #252525;
      --bg-el-r: 20;  --bg-el-g: 20;  --bg-el-b: 20;
      --bd-1: #1c1c1c;  --bd-2: #242424;  --bd-3: #2e2e2e;
      --tx-m: #666666;  --tx-x: #666666;  --tx-xx: #666666;
      --ph: #4a4a4a;  --scrollbar: #242424;
      --ac: #3b82f6;  --ac-h: #60a5fa;  --ac-d: #2563eb;  --ac-sf: #0a1628;
      --ac-t4: #93c5fd;  --ac-t3: #bfdbfe;  --ac-t5: #60a5fa;  --ac-t6: #3b82f6;
      --ac-bd: #3b82f6;  --ac-bd9: #1e3a8a;
      --ac-r: 59;  --ac-g: 130;  --ac-b: 246;
    }

    /* ── Light ───────────────────────────────────────────────────────── */
    html:not(.dark) {
      color-scheme: light;
      --bg-pg: #f8fafc;  --bg-sf: #ffffff;  --bg-el: #f1f5f9;
      --bg-h1: #e9eef5;  --bg-h2: #e2e8f0;  --bg-h3: #cbd5e1;
      --bg-el-r: 241;  --bg-el-g: 245;  --bg-el-b: 249;
      --bd-1: #e2e8f0;  --bd-2: #cbd5e1;  --bd-3: #94a3b8;
      --tx-p: #0f172a;   --tx-s1: #1e293b;  --tx-s2: #334155;
      --tx-s3: #475569;  --tx-s4: #64748b;
      --tx-m: #64748b;  --tx-x: #6e8296;  --tx-xx: #7a8fa3;
      --ph: #94a3b8;  --scrollbar: #cbd5e1;
      --ac: #1e5fcc;  --ac-h: #2563eb;  --ac-d: #1a4fa8;  --ac-sf: #eff6ff;
      --ac-t4: #1e5fcc;  --ac-t3: #2563eb;  --ac-t5: #1e5fcc;  --ac-t6: #1a4fa8;
      --ac-bd: #1e5fcc;  --ac-bd9: #1e40af;
      --ac-r: 30;  --ac-g: 95;  --ac-b: 204;
    }

    /* ── Breeze ──────────────────────────────────────────────────────── */
    html:not(.dark)[data-theme="breeze"] {
      --bg-pg: #dce9f7;  --bg-sf: #eef5fd;  --bg-el: #f5f9ff;
      --bg-h1: #cfe0f2;  --bg-h2: #c1d6ed;  --bg-h3: #b0c8e6;
      --bg-el-r: 245;  --bg-el-g: 249;  --bg-el-b: 255;
      --bd-1: #93c4e8;  --bd-2: #7aaac5;  --bd-3: #5e92b5;
      --tx-p: #12263f;   --tx-s1: #182e4a;  --tx-s2: #2c4a6a;
      --tx-s3: #3a5f82;  --tx-s4: #4f7099;
      --tx-m: #4f7099;  --tx-x: #5e7ea6;  --tx-xx: #6a8bb5;
      --ph: #6a8bb5;  --scrollbar: #93c4e8;
      --ac: #0059b3;  --ac-h: #006fd8;  --ac-d: #004a96;  --ac-sf: #e0f0ff;
      --ac-t4: #0059b3;  --ac-t3: #006fd8;  --ac-t5: #0059b3;  --ac-t6: #004a96;
      --ac-bd: #0059b3;  --ac-bd9: #1e3a8a;
      --ac-r: 0;  --ac-g: 89;  --ac-b: 179;
    }

    /* ── Catppuccin Frappé (catppuccin.com, mauve accent) ── */
    html[data-theme="ctp-frappe"] {
      --bg-pg: #292c3c;  --bg-sf: #303446;  --bg-el: #414559;
      --bg-h1: #494e63;  --bg-h2: #51576d;  --bg-h3: #626880;
      --bg-el-r: 65;  --bg-el-g: 69;  --bg-el-b: 89;
      --bd-1: #414559;  --bd-2: #51576d;  --bd-3: #626880;
      --tx-p: #c6d0f5;   --tx-s1: #c6d0f5;  --tx-s2: #b5bfe2;
      --tx-s3: #b5bfe2;  --tx-s4: #a5adce;
      --tx-m: #838ba7;  --tx-x: #838ba7;  --tx-xx: #737994;
      --ph: #737994;  --scrollbar: #51576d;
      --ac: #ca9ee6;  --ac-h: #c9abea;  --ac-d: #ab89c6;  --ac-sf: #47445e;
      --ac-t4: #ca9ee6;  --ac-t3: #c8b2ec;  --ac-t5: #ca9ee6;  --ac-t6: #ca9ee6;
      --ac-bd: #ca9ee6;  --ac-bd9: #66597e;
      --ac-r: 202;  --ac-g: 158;  --ac-b: 230;
      --ac-on: #232634;
    }
    /* ── Catppuccin Macchiato (catppuccin.com, mauve accent) ── */
    html[data-theme="ctp-macchiato"] {
      --bg-pg: #1e2030;  --bg-sf: #24273a;  --bg-el: #363a4f;
      --bg-h1: #40445a;  --bg-h2: #494d64;  --bg-h3: #5b6078;
      --bg-el-r: 54;  --bg-el-g: 58;  --bg-el-b: 79;
      --bd-1: #363a4f;  --bd-2: #494d64;  --bd-3: #5b6078;
      --tx-p: #cad3f5;   --tx-s1: #cad3f5;  --tx-s2: #b8c0e0;
      --tx-s3: #b8c0e0;  --tx-s4: #a5adcb;
      --tx-m: #8087a2;  --tx-x: #8087a2;  --tx-xx: #6e738d;
      --ph: #6e738d;  --scrollbar: #494d64;
      --ac: #c6a0f6;  --ac-h: #c7adf6;  --ac-d: #a688d0;  --ac-sf: #3c3956;
      --ac-t4: #c6a0f6;  --ac-t3: #c8b4f6;  --ac-t5: #c6a0f6;  --ac-t6: #c6a0f6;
      --ac-bd: #c6a0f6;  --ac-bd9: #5d517c;
      --ac-r: 198;  --ac-g: 160;  --ac-b: 246;
      --ac-on: #181926;
    }
    /* ── Catppuccin Mocha (catppuccin.com, mauve accent) ── */
    html[data-theme="ctp-mocha"] {
      --bg-pg: #181825;  --bg-sf: #1e1e2e;  --bg-el: #313244;
      --bg-h1: #3b3d4f;  --bg-h2: #45475a;  --bg-h3: #585b70;
      --bg-el-r: 49;  --bg-el-g: 50;  --bg-el-b: 68;
      --bd-1: #313244;  --bd-2: #45475a;  --bd-3: #585b70;
      --tx-p: #cdd6f4;   --tx-s1: #cdd6f4;  --tx-s2: #bac2de;
      --tx-s3: #bac2de;  --tx-s4: #a6adc8;
      --tx-m: #7f849c;  --tx-x: #7f849c;  --tx-xx: #6c7086;
      --ph: #6c7086;  --scrollbar: #45475a;
      --ac: #cba6f7;  --ac-h: #ccb2f6;  --ac-d: #a88bcf;  --ac-sf: #38324c;
      --ac-t4: #cba6f7;  --ac-t3: #ccb9f6;  --ac-t5: #cba6f7;  --ac-t6: #cba6f7;
      --ac-bd: #cba6f7;  --ac-bd9: #5b4e74;
      --ac-r: 203;  --ac-g: 166;  --ac-b: 247;
      --ac-on: #11111b;
    }
    /* ── Catppuccin Latte (catppuccin.com, mauve accent) ── */
    html:not(.dark)[data-theme="ctp-latte"] {
      --bg-pg: #dce0e8;  --bg-sf: #eff1f5;  --bg-el: #e6e9ef;
      --bg-h1: #e1e5ec;  --bg-h2: #ccd0da;  --bg-h3: #bcc0cc;
      --bg-el-r: 230;  --bg-el-g: 233;  --bg-el-b: 239;
      --bd-1: #ccd0da;  --bd-2: #bcc0cc;  --bd-3: #acb0be;
      --tx-p: #4c4f69;   --tx-s1: #4c4f69;  --tx-s2: #5c5f77;
      --tx-s3: #5c5f77;  --tx-s4: #6c6f85;
      --tx-m: #6c6f85;  --tx-x: #7c7f93;  --tx-xx: #8c8fa1;
      --ph: #9ca0b0;  --scrollbar: #bcc0cc;
      --ac: #8839ef;  --ac-h: #7a33d7;  --ac-d: #6d2ebf;  --ac-sf: #e5dff4;
      --ac-t4: #8839ef;  --ac-t3: #7a33d7;  --ac-t5: #8839ef;  --ac-t6: #6d2ebf;
      --ac-bd: #8839ef;  --ac-bd9: #bc95f2;
      --ac-r: 136;  --ac-g: 57;  --ac-b: 239;
      --ac-on: #ffffff;
    }

    /* Catppuccin dark flavours also tint the body text (other dark themes keep Tailwind's greys) */
    html.dark[data-theme^="ctp-"] .text-white    { color: var(--tx-p)  !important; }
    html.dark[data-theme^="ctp-"] .text-gray-100 { color: var(--tx-s1) !important; }
    html.dark[data-theme^="ctp-"] .text-gray-200 { color: var(--tx-s2) !important; }
    html.dark[data-theme^="ctp-"] .text-gray-300 { color: var(--tx-s3) !important; }
    html.dark[data-theme^="ctp-"] .text-gray-400 { color: var(--tx-s4) !important; }
    /* Mauve is a light pastel: text on accent fills is dark, as in Catppuccin's own ports */
    html[data-theme^="ctp-"] :is(.bg-indigo-500, .bg-indigo-600, .bg-indigo-700).text-white,
    html[data-theme^="ctp-"] :is(.bg-indigo-500, .bg-indigo-600, .bg-indigo-700) .text-white { color: var(--ac-on) !important; }

    /* Status colours (red, amber, green, blue…) in Catppuccin themes, unless the user picked
       "Tailwind" in Settings → Appearance. Covers the classes the views use; generated from
       the official palette (red→Red, orange→Peach, amber/yellow→Yellow, green/emerald→Green,
       blue→Blue, violet→Mauve). */
    html[data-theme="ctp-latte"]:not([data-status-colors="tailwind"]) {
      --st-red: #d20f39; --st-red-l: #a3254a; --st-red-t: #ebd1db; --st-red-t2: #e8bbc8; --st-red-b: #e397aa;
      --st-maroon: #e64553; --st-maroon-l: #b0485b; --st-maroon-t: #eed9de; --st-maroon-t2: #edc8ce; --st-maroon-b: #ebacb4;
      --st-peach: #fe640b; --st-peach-l: #c05d2c; --st-peach-t: #f1ddd4; --st-peach-t2: #f3cfbd; --st-peach-b: #f5b997;
      --st-yellow: #df8e1d; --st-yellow-l: #ac7838; --st-yellow-t: #ede3d7; --st-yellow-t2: #ebd9c1; --st-yellow-b: #e9c99f;
      --st-green: #40a02b; --st-green-l: #448441; --st-green-t: #d6e6d9; --st-green-t2: #c5dec5; --st-green-b: #a9d1a4;
      --st-blue: #1e66f5; --st-blue-l: #2e5ec4; --st-blue-t: #d2def5; --st-blue-t2: #bdd0f5; --st-blue-b: #9bb9f5;
      --st-mauve: #8839ef; --st-mauve-l: #7341c0; --st-mauve-t: #e1d7f4; --st-mauve-t2: #d6c5f4; --st-mauve-b: #c6a7f3;
      --st-on: #ffffff;
    }
    html[data-theme="ctp-frappe"]:not([data-status-colors="tailwind"]) {
      --st-red: #e78284; --st-red-l: #db9dac; --st-red-t: #4a3f4f; --st-red-t2: #5c4755; --st-red-b: #79535f;
      --st-maroon: #ea999c; --st-maroon-l: #ddacbb; --st-maroon-t: #4a4252; --st-maroon-t2: #5d4c5b; --st-maroon-b: #7a5c68;
      --st-peach: #ef9f76; --st-peach-l: #e1b0a2; --st-peach-t: #4b434d; --st-peach-t2: #5e4e52; --st-peach-b: #7c5f59;
      --st-yellow: #e5c890; --st-yellow-l: #dacbb3; --st-yellow-t: #494950; --st-yellow-t2: #5b5858; --st-yellow-b: #786f64;
      --st-green: #a6d189; --st-green-l: #b1d1af; --st-green-t: #414a4f; --st-green-t2: #4c5a56; --st-green-b: #5f7361;
      --st-blue: #8caaee; --st-blue-l: #a0b7f0; --st-blue-t: #3d455e; --st-blue-t2: #46506e; --st-blue-b: #556389;
      --st-mauve: #ca9ee6; --st-mauve-l: #c9b0eb; --st-mauve-t: #46435c; --st-mauve-t2: #554d6c; --st-mauve-b: #6e5e86;
      --st-on: #232634;
    }
    html[data-theme="ctp-macchiato"]:not([data-status-colors="tailwind"]) {
      --st-red: #ed8796; --st-red-l: #e1a2b7; --st-red-t: #403447; --st-red-t2: #543e50; --st-red-b: #744d5f;
      --st-maroon: #ee99a0; --st-maroon-l: #e1adbe; --st-maroon-t: #403748; --st-maroon-t2: #544252; --st-maroon-b: #755563;
      --st-peach: #f5a97f; --st-peach-l: #e6b8a8; --st-peach-t: #413944; --st-peach-t2: #56464b; --st-peach-b: #785b56;
      --st-yellow: #eed49f; --st-yellow-l: #e1d4bd; --st-yellow-t: #403f48; --st-yellow-t2: #545152; --st-yellow-b: #756c62;
