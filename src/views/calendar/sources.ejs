<div class="max-w-xl mx-auto py-6 px-4">

  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <a href="/calendar" class="text-sm text-gray-500 hover:text-gray-300 transition-colors">← Calendar</a>
      <h1 class="hidden lg:block text-xl font-bold text-white">Calendar Sources</h1>
    </div>
  </div>

  <% if (errors.length) { %>
    <div class="mb-4 px-4 py-3 rounded-lg bg-red-950 border border-red-800 text-red-300 text-sm">
      <% errors.forEach(e => { %><div><%= e %></div><% }); %>
    </div>
  <% } %>
  <% if (success) { %>
    <div class="mb-4 px-4 py-3 rounded-lg bg-emerald-950 border border-emerald-800 text-emerald-300 text-sm">
      <%= success %>
    </div>
  <% } %>

  <% if (demoMode) { %>
    <div class="mb-4 px-4 py-3 rounded-lg bg-amber-950 border border-amber-800 text-amber-300 text-sm">Calendar accounts and notification channels aren't available on the demo. Run your own Obelo server to connect them.</div>
  <% } %>
  <!-- Connected sources -->
  <% if (sources.length > 0) { %>
    <div class="mb-8 space-y-3">
      <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Connected</h2>
      <% sources.forEach(src => { %>
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-4 space-y-3">
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-center gap-3">
              <!-- Clickable color dot -->
              <form method="POST" action="/calendar/sources/<%= src.id %>/color" id="colorForm-<%= src.id %>">
                <label title="Change color"
                       class="w-3 h-3 rounded-full shrink-0 cursor-pointer block hover:scale-125 transition-transform"
                       style="background-color:<%= src.color %>;">
                  <input type="color" name="color" value="<%= src.color || '#6366f1' %>"
                         class="sr-only"
                         onchange="this.closest('form').submit(); this.closest('label').style.backgroundColor = this.value;" />
                </label>
              </form>
              <div>
                <div class="text-sm font-medium text-white"><%= src.name %></div>
                <div class="text-xs text-gray-500">
                  <%= src.type === 'google' ? 'Google Calendar' : 'CALDAV' %>
                  <% if (src.lastSynced) { %>
                    · Last synced <%= new Date(src.lastSynced).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %>
                  <% } else { %>
                    · Never synced
                  <% } %>
                  <% if (src.isFamilyCalendar) { %>
                    · <span class="text-indigo-400">Family calendar</span>
                  <% } %>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <!-- Sync now -->
              <form method="POST" action="/calendar/sources/<%= src.id %>/sync">
                <button type="submit"
                        class="px-3 py-1 rounded-lg bg-gray-800 hover:bg-gray-700 text-xs text-gray-400 hover:text-white border border-gray-700 transition-colors">
                  Sync now
                </button>
              </form>
              <!-- Delete -->
              <form method="POST" action="/calendar/sources/<%= src.id %>/delete"
                    onsubmit="return confirm('Remove this calendar? All synced events will be deleted.')">
                <button type="submit"
                        class="px-3 py-1 rounded-lg bg-gray-800 hover:bg-red-950 text-xs text-gray-500 hover:text-red-400 border border-gray-700 transition-colors">
                  Remove
                </button>
              </form>
            </div>
          </div>

          <!-- Calendar selection -->
          <% if (src.credentials?.discoveredCalendars?.length > 0) { %>
            <% const selected = src.credentials.selectedCalendarUrls || []; %>
            <% const allSelected = selected.length === 0; %>
            <details class="text-xs" <%= src.credentials.discoveredCalendars.length > 1 ? '' : 'open' %>>
              <summary class="cursor-pointer text-gray-500 hover:text-gray-300 transition-colors select-none">
                Calendars to sync (<%= allSelected ? 'all' : selected.length %>/<%= src.credentials.discoveredCalendars.length %>)
              </summary>
              <form method="POST" action="/calendar/sources/<%= src.id %>/set-calendars" class="mt-3 space-y-2">
                <% src.credentials.discoveredCalendars.forEach(cal => { %>
                  <% const isChecked = allSelected || selected.includes(cal.url); %>
                  <label class="flex items-center gap-2 cursor-pointer group">
                    <input type="checkbox" name="calendarUrls" value="<%= cal.url %>"
                           <%= isChecked ? 'checked' : '' %>
                           class="w-3.5 h-3.5 rounded accent-indigo-500">
                    <span class="text-gray-300 group-hover:text-white transition-colors">
                      <%= cal.displayName %>
                    </span>
                  </label>
                <% }); %>
                <div class="pt-2 flex items-center gap-2">
                  <button type="submit"
                          class="px-3 py-1 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs transition-colors">
                    Save & sync
                  </button>
                  <span class="text-gray-600">saves selection and re-syncs</span>
                </div>
              </form>
            </details>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% } %>

  <!-- Default Calendar -->
  <% if (selectableCalendars.length > 1) { %>
    <div class="mb-8">
      <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Default Calendar</h2>
      <div class="bg-gray-900 border border-gray-800 rounded-xl p-4">
        <form method="POST" action="/calendar/set-default" class="flex gap-3 items-center">
          <select name="calendarTarget"
                  class="flex-1 bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-hidden focus:border-indigo-500">
            <% selectableCalendars.forEach(cal => { %>
              <option value="<%= cal.value %>" <%= cal.value === defaultCalendarTarget ? 'selected' : '' %>><%= cal.label %></option>
            <% }); %>
          </select>
          <button type="submit"
                  class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium transition-colors">
            Save
          </button>
        </form>
        <p class="text-xs text-gray-600 mt-2">Pre-selected when creating new events.</p>
      </div>
    </div>
  <% } %>

  <!-- Shared (Local) Calendars -->
  <div class="mb-8">
    <div class="flex items-center justify-between mb-2">
      <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Shared Calendars</h2>
      <a href="/calendar/local-calendars/new"
         class="px-3 py-1 rounded-lg bg-gray-800 hover:bg-gray-700 text-xs text-gray-400 hover:text-white border border-gray-700 transition-colors">
        + New calendar
      </a>
    </div>
    <% if (localCalendars.length > 0) { %>
      <datalist id="shareable-users">
        <% shareableUsers.forEach(u => { %>
          <option value="<%= u.username %>"><%= u.displayName %> (@<%= u.username %>)</option>
        <% }); %>
      </datalist>
      <div class="space-y-3">
        <% localCalendars.forEach(lc => { %>
          <div class="bg-gray-900 border border-gray-800 rounded-xl p-4">
            <div class="flex items-start justify-between gap-3 mb-3">
              <div class="flex items-center gap-3">
                <form method="POST" action="/calendar/local-calendars/<%= lc.id %>/color" id="lcColorForm-<%= lc.id %>">
                  <label title="Change color"
                         class="w-3 h-3 rounded-full shrink-0 cursor-pointer block hover:scale-125 transition-transform"
                         style="background-color:<%= lc.color %>;">
                    <input type="color" name="color" value="<%= lc.color || '#6366f1' %>"
                           class="sr-only"
                           onchange="this.closest('form').submit(); this.closest('label').style.backgroundColor = this.value;" />
                  </label>
                </form>
                <span class="text-sm font-medium text-white"><%= lc.name %></span>
              </div>
              <form method="POST" action="/calendar/local-calendars/<%= lc.id %>/delete"
                    data-confirm="Delete <%= lc.name %>? Events in this calendar will be kept but unlinked from the calendar."
                    onsubmit="return confirm(this.dataset.confirm)">
                <button type="submit"
                        class="px-3 py-1 rounded-lg bg-gray-800 hover:bg-red-950 text-xs text-gray-500 hover:text-red-400 border border-gray-700 transition-colors">
                  Delete
                </button>
              </form>
            </div>

            <% if (lc.members.length > 0) { %>
              <div class="text-xs text-gray-500 mb-1">Shared with:</div>
              <div class="space-y-1 mb-3">
                <% lc.members.forEach(m => { %>
                  <div class="flex items-center justify-between">
                    <span class="text-xs text-gray-400"><%= m.user.displayName || m.user.username %></span>
                    <form method="POST" action="/calendar/local-calendars/<%= lc.id %>/members/<%= m.user.id %>/remove">
                      <button type="submit" class="text-[10px] text-gray-600 hover:text-red-400 transition-colors">remove</button>
                    </form>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="text-xs text-gray-600 mb-3">Not shared with anyone yet.</div>
            <% } %>

            <form method="POST" action="/calendar/local-calendars/<%= lc.id %>/members" class="flex gap-2">
              <input type="text" name="username" placeholder="Add by username" autocomplete="off" list="shareable-users"
                     class="flex-1 bg-gray-800 border border-gray-700 rounded-lg px-3 py-1.5 text-white text-xs focus:outline-hidden focus:border-indigo-500 placeholder-gray-600">
              <button type="submit"
                      class="px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs transition-colors">
                Add
              </button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="bg-gray-900 border border-gray-800 rounded-xl p-5 text-sm text-gray-600">
        No shared calendars yet. Create one to share events with other Obelo users.
      </div>
    <% } %>
  </div>

  <!-- Connect new source -->
  <% if (!demoMode) { %>
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
    <h2 class="text-sm font-semibold text-white mb-4">Connect a Calendar</h2>

    <form method="POST" action="/calendar/sources" class="space-y-4" id="connectForm">
      <input type="hidden" name="provider" id="providerInput" value="apple">
      <input type="hidden" name="serverUrl" id="serverUrlInput" value="https://caldav.icloud.com">
      <input type="hidden" name="calendarHomeUrl" id="calendarHomeUrlInput" value="">

      <!-- Provider picker -->
      <div class="grid grid-cols-3 gap-2">
        <%
          const providers = [
            {
              id: 'apple',
              label: 'Apple iCloud',
              icon: `<svg viewBox="0 0 24 24" class="w-6 h-6" fill="currentColor">
                <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.7 9.05 7.4c1.39.07 2.35.77 3.17.8 1.21-.25 2.37-1 3.64-.84 1.57.2 2.75.84 3.51 2.12-3.22 1.94-2.42 6.08.68 7.3-.5 1.22-1.14 2.41-3 3.5zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
              </svg>`
            },
            {
              id: 'google',
              label: 'Google',
              icon: `<svg viewBox="0 0 24 24" class="w-6 h-6" fill="none">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
              </svg>`
            },
            {
              id: 'other',
              label: 'Other CalDAV',
              icon: `<svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
              </svg>`
            },
          ];
          providers.forEach(p => {
        %>
          <label class="provider-option flex flex-col items-center gap-1.5 px-3 py-3 rounded-xl border cursor-pointer transition-colors
                         <%= p.id === 'apple' ? 'border-indigo-500 bg-indigo-950 text-white' : 'border-gray-700 bg-gray-800 hover:border-gray-600 text-gray-400' %>"
                 data-provider="<%= p.id %>">
            <input type="radio" name="_provider" value="<%= p.id %>" class="sr-only" <%= p.id === 'apple' ? 'checked' : '' %>>
            <%- p.icon %>
            <span class="text-xs font-medium <%= p.id === 'apple' ? 'text-indigo-300' : 'text-gray-400' %>"><%= p.label %></span>
          </label>
        <% }); %>
      </div>

      <!-- Hint text -->
      <p id="providerHint" class="text-xs text-gray-500">
        Use your Apple ID and an <strong class="text-gray-400">app-specific password</strong> from
        <span class="text-gray-400">appleid.apple.com → Security → App-Specific Passwords</span>.
      </p>

      <!-- Google: OAuth button (shown instead of credentials) -->
      <div id="googleOAuthSection" class="hidden">
        <a href="/calendar/auth/google"
           class="flex items-center justify-center gap-3 w-full py-2.5 rounded-lg bg-white hover:bg-gray-100 text-gray-800 font-medium text-sm transition-colors border border-gray-200">
          <svg viewBox="0 0 24 24" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Sign in with Google
        </a>
        <p class="text-xs text-gray-600 mt-2 text-center">You'll be redirected to Google to approve access.</p>
      </div>

      <!-- Apple / Other: credentials form fields -->
      <div id="credentialFields">
        <div class="space-y-3">
          <div>
            <label class="block text-xs font-medium text-gray-400 mb-1" id="usernameLabel">Apple ID email</label>
            <input type="text" name="username" id="usernameInput" autocomplete="username"
                   class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-hidden focus:border-indigo-500 placeholder-gray-600"
                   placeholder="you@icloud.com">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-400 mb-1">App-specific password</label>
            <input type="password" name="password" autocomplete="current-password"
                   class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-hidden focus:border-indigo-500 placeholder-gray-600"
                   placeholder="xxxx-xxxx-xxxx-xxxx">
          </div>
        </div>

        <!-- Other: manual server URL -->
        <div id="otherFields" class="hidden space-y-3 mt-3">
          <div>
            <label class="block text-xs font-medium text-gray-400 mb-1">Server URL</label>
            <input type="text" id="otherServerUrl"
                   class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-hidden focus:border-indigo-500 placeholder-gray-600"
                   placeholder="https://caldav.example.com">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-400 mb-1">Calendar home URL <span class="text-gray-600">(optional)</span></label>
            <input type="text" id="otherCalendarHomeUrl"
                   class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-hidden focus:border-indigo-500 placeholder-gray-600"
                   placeholder="https://caldav.example.com/principals/user/">
          </div>
        </div>

        <!-- Color -->
        <div class="flex items-center gap-3 mt-3">
          <label class="text-xs font-medium text-gray-400">Color</label>
          <input type="color" name="color" value="#6366f1"
                 class="h-8 w-16 bg-gray-800 border border-gray-700 rounded-lg px-1 py-1 cursor-pointer focus:outline-hidden">
        </div>

        <button type="submit" id="connectBtn"
                class="w-full mt-3 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm transition-colors">
          Connect & sync
        </button>
      </div>
    </form>
  </div>
  <% } %>

</div>


<script>
(function () {
  const hints = {
    apple: 'Use your Apple ID and an <strong class="text-gray-400">app-specific password</strong> from <span class="text-gray-400">appleid.apple.com → Security → App-Specific Passwords</span>.',
    google: 'Sign in with your Google account. Obelo will request read access to your calendars.',
    other:  'Enter your server URL and credentials. CalDAV-compatible servers include Nextcloud, Fastmail, and Radicale.',
  };
  const userLabels = { apple: 'Apple ID email', other: 'Username' };
  const userPlaceholders = { apple: 'you@icloud.com', other: 'username or email' };

  const providerInput    = document.getElementById('providerInput');
  const serverUrlInput   = document.getElementById('serverUrlInput');
  const homeUrlInput     = document.getElementById('calendarHomeUrlInput');
  const hintEl           = document.getElementById('providerHint');
  const usernameInput    = document.getElementById('usernameInput');
  const usernameLabel    = document.getElementById('usernameLabel');
  const otherFields      = document.getElementById('otherFields');
  const otherServerEl    = document.getElementById('otherServerUrl');
  const otherHomeEl      = document.getElementById('otherCalendarHomeUrl');
  const credentialFields = document.getElementById('credentialFields');
  const googleOAuthSection = document.getElementById('googleOAuthSection');

  function setProvider(p) {
    providerInput.value  = p;
    hintEl.innerHTML     = hints[p];

    const isGoogle = p === 'google';
    credentialFields.classList.toggle('hidden', isGoogle);
    googleOAuthSection.classList.toggle('hidden', !isGoogle);

    if (!isGoogle) {
      usernameLabel.textContent   = userLabels[p] || 'Username';
      usernameInput.placeholder   = userPlaceholders[p] || '';
      otherFields.classList.toggle('hidden', p !== 'other');
    }

    if (p === 'apple') {
      serverUrlInput.value = 'https://caldav.icloud.com';
      homeUrlInput.value   = '';
    } else if (p === 'other') {
      serverUrlInput.value = otherServerEl.value;
      homeUrlInput.value   = otherHomeEl.value;
    }

    document.querySelectorAll('.provider-option').forEach(el => {
      const active = el.dataset.provider === p;
      el.classList.toggle('border-indigo-500', active);
      el.classList.toggle('bg-indigo-950',     active);
      el.classList.toggle('border-gray-700',   !active);
      el.classList.toggle('bg-gray-800',       !active);
      el.querySelector('span:last-child').classList.toggle('text-indigo-300', active);
      el.querySelector('span:last-child').classList.toggle('text-gray-400',   !active);
    });
  }

  document.querySelectorAll('.provider-option').forEach(el => {
    el.addEventListener('click', () => setProvider(el.dataset.provider));
  });

  otherServerEl.addEventListener('input', () => {
    if (providerInput.value === 'other') serverUrlInput.value = otherServerEl.value;
  });
  otherHomeEl.addEventListener('input', () => {
    if (providerInput.value === 'other') homeUrlInput.value = otherHomeEl.value;
  });
})();
</script>
