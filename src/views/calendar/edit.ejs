<div class="max-w-lg mx-auto py-6 px-4">

  <a href="/calendar/events/<%= event.id %>" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-300 mb-6 transition-colors">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
    </svg>
    Back to event
  </a>

  <h1 class="text-xl font-bold text-white mb-6">Edit Event</h1>

  <% if (errors.length) { %>
    <div class="mb-4 px-4 py-3 rounded-lg bg-red-950 border border-red-800 text-red-300 text-sm">
      <% errors.forEach(e => { %><div><%= e %></div><% }); %>
    </div>
  <% } %>

  <form method="POST" action="/calendar/events/<%= event.id %>" class="space-y-4">

    <div>
      <label class="block text-xs font-medium text-gray-400 mb-1">Title <span class="text-red-500">*</span></label>
      <input type="text" name="title" required autofocus
             class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-hidden focus:border-indigo-500 placeholder-gray-600"
             value="<%= event.title %>">
    </div>

    <div>
      <label class="block text-xs font-medium text-gray-400 mb-1">Date <span class="text-red-500">*</span></label>
      <input type="date" name="eventDate" required
             value="<%= startDate %>"
             class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-hidden focus:border-indigo-500">
    </div>

    <!-- All day toggle -->
    <div class="flex items-center gap-3">
      <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" name="allDay" id="allDay" class="sr-only peer" onchange="toggleAllDay(this)" <%= event.allDay ? 'checked' : '' %>>
        <div class="w-9 h-5 bg-gray-700 peer-checked:bg-indigo-600 rounded-full transition-colors after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-transform peer-checked:after:translate-x-4"></div>
      </label>
      <span class="text-sm text-gray-400">All day</span>
    </div>

    <div id="timeFields" class="grid grid-cols-2 gap-3" style="<%= event.allDay ? 'display:none' : '' %>">
      <div>
        <label class="block text-xs font-medium text-gray-400 mb-1">Start time</label>
        <input type="time" name="startTime" value="<%= startTime %>"
               class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-hidden focus:border-indigo-500">
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-400 mb-1">End time</label>
        <input type="time" name="endTime" value="<%= endTime %>"
               class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-hidden focus:border-indigo-500">
      </div>
    </div>

    <div>
      <label class="block text-xs font-medium text-gray-400 mb-1">Location</label>
      <input type="text" name="location"
             class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-hidden focus:border-indigo-500 placeholder-gray-600"
             placeholder="Optional" value="<%= event.location || '' %>">
    </div>

    <div>
      <label class="block text-xs font-medium text-gray-400 mb-1">Notes</label>
      <textarea name="description" rows="3"
                class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-hidden focus:border-indigo-500 placeholder-gray-600 resize-none"
                placeholder="Optional"><%= (event.description || '').replace(/^\[vT\]\s*/, '') %></textarea>
    </div>

    <div class="flex gap-3 pt-2">
      <button type="submit"
              class="flex-1 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm transition-colors">
        Update event
      </button>
      <a href="/calendar/events/<%= event.id %>"
         class="px-4 py-2 rounded-lg bg-gray-800 hover:bg-gray-700 text-gray-400 hover:text-white border border-gray-700 text-sm transition-colors">
        Cancel
      </a>
    </div>

  </form>
</div>

<script>
function toggleAllDay(cb) {
  document.getElementById('timeFields').style.display = cb.checked ? 'none' : '';
}
</script>
