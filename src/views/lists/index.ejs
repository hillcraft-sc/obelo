<div class="max-w-3xl mx-auto px-4 py-6 space-y-5">

  <div class="flex items-center justify-between gap-3">
    <%- include('../partials/page-heading', { heading: 'Lists', description: 'Quick, shareable checklists.' }) %>
    <button type="button" onclick="toggleAddForm('new-list-form')"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium transition-colors shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      New list
    </button>
  </div>

  <% if (error) { %>
    <div class="rounded-xl bg-red-950 border border-red-800 px-4 py-3 text-sm text-red-300"><%= error %></div>
  <% } %>

  <!-- New list form -->
  <div id="new-list-form" class="<%= error ? '' : 'hidden' %>">
    <form action="/lists" method="POST" class="flex gap-2">
      <input type="text" name="title" placeholder="New list name…" required
             class="flex-1 bg-gray-900 border border-gray-800 rounded-xl px-4 py-2.5 text-sm text-gray-100
                    placeholder-gray-600 focus:outline-hidden focus:border-indigo-500" />
      <button type="submit"
              class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-xl transition-colors">
        Create
      </button>
    </form>
  </div>

  <!-- My Lists -->
  <% if (lists.length === 0 && sharedLists.length === 0) { %>
    <%- include('../partials/empty-state', { message: 'No lists yet.', action: { label: 'New list', onclick: "toggleAddForm('new-list-form')" } }) %>
  <% } %>

  <% if (lists.length > 0) { %>
    <div>
      <% if (sharedLists.length > 0) { %>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">My Lists</p>
      <% } %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <% lists.forEach(list => { %>
          <a href="/lists/<%= list.id %>"
             class="bg-gray-900 border border-gray-800 rounded-xl p-4 hover:border-gray-700 transition-colors block">
            <p class="text-sm font-semibold text-gray-100 truncate"><%= list.title %></p>
            <p class="text-xs text-gray-500 mt-1">
              <%= list.items.length %> active
              <% const done = list._count.items - list.items.length; %>
              <% if (done > 0) { %> · <%= done %> done<% } %>
            </p>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Shared with me -->
  <% if (sharedLists.length > 0) { %>
    <div>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Shared with me</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <% sharedLists.forEach(list => { %>
          <a href="/lists/<%= list.id %>"
             class="bg-gray-900 border border-gray-800 rounded-xl p-4 hover:border-gray-700 transition-colors block">
            <div class="flex items-start justify-between gap-2">
              <p class="text-sm font-semibold text-gray-100 truncate"><%= list.title %></p>
              <span class="text-[10px] font-medium px-1.5 py-0.5 rounded-full bg-indigo-500/15 text-indigo-400 shrink-0">shared</span>
            </div>
            <p class="text-xs text-gray-500 mt-1">
              by <%= list.user.displayName %> ·
              <%= list.items.length %> active
              <% const done2 = list._count.items - list.items.length; %>
              <% if (done2 > 0) { %> · <%= done2 %> done<% } %>
            </p>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>

</div>

<script>
  // "New …" button opens the add form, and focuses its first field
  function toggleAddForm(id) {
    var form = document.getElementById(id);
    form.classList.toggle('hidden');
    if (!form.classList.contains('hidden')) form.querySelector('input:not([type=hidden])').focus();
  }
</script>
