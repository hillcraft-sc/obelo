<%
  // Tag picker: the selected tags show as pills inside the box; the dropdown lists the rest.
  // Locals: allTags (every tag the user has), selectedTags (this note's tags)
%>
<div>
  <label class="block text-sm font-medium text-gray-400 mb-1.5">Tags</label>
  <div data-tag-picker
       data-all="<%= JSON.stringify(allTags || []) %>"
       data-selected="<%= JSON.stringify(selectedTags || []) %>"
       class="relative">
    <div data-tag-box
         class="flex flex-wrap items-center gap-1.5 min-h-[42px] max-h-28 overflow-y-auto px-2.5 py-1.5 rounded-lg bg-gray-800 border border-gray-700 cursor-text focus-within:ring-2 focus-within:ring-indigo-500">
      <span data-tag-chips class="contents"></span>
      <input type="text" data-tag-input autocomplete="off" placeholder="Add a tag…"
             class="flex-1 min-w-[8rem] bg-transparent py-0.5 text-sm text-gray-100 placeholder-gray-600 focus:outline-none" />
    </div>
    <input type="hidden" name="tags" id="tags" value="<%= (selectedTags || []).join(', ') %>"<% if (typeof formId !== 'undefined' && formId) { %> form="<%= formId %>"<% } %> />
    <div data-tag-menu
         class="hidden absolute z-30 left-0 right-0 mt-1 max-h-60 overflow-y-auto rounded-lg bg-gray-900 border border-gray-700 shadow-xl py-1"></div>
  </div>
  <p class="text-xs text-gray-600 mt-1.5">Pick a tag from the list, or type a new one and press Enter.</p>
</div>
