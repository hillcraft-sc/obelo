<style>
  .prose { overflow-wrap: break-word; word-break: break-word; }
  .prose h1,.prose h2,.prose h3 { color:#f3f4f6; font-weight:600; margin:.75em 0 .4em; }
  .prose h1 { font-size:1.4rem; } .prose h2 { font-size:1.2rem; } .prose h3 { font-size:1rem; }
  .prose p { color:#d1d5db; line-height:1.75; margin-bottom:.75em; }
  .prose a { color:#818cf8; text-decoration:underline; }
  .prose strong { color:#f9fafb; font-weight:600; }
  .prose code { background:#1f2937; color:#a5b4fc; padding:2px 6px; border-radius:4px; font-size:.875em; }
  .prose pre { background:#111827; border:1px solid #374151; padding:.75rem 1rem; border-radius:8px; overflow-x:auto; margin-bottom:.75em; }
  .prose pre code { background:none; padding:0; color:#e5e7eb; }
  .prose blockquote { border-left:3px solid #4b5563; padding-left:1rem; color:#9ca3af; margin:.75em 0; }
  .prose ul { list-style:disc; padding-left:1.5rem; color:#d1d5db; margin-bottom:.75em; }
  .prose ol { list-style:decimal; padding-left:1.5rem; color:#d1d5db; margin-bottom:.75em; }
  .prose li { margin-bottom:.2em; }
  .prose ins { text-decoration: underline; }
  [data-tooltip] { position: relative; }
  [data-tooltip]::after { content: attr(data-tooltip); position: absolute; bottom: calc(100% + 5px); left: 50%; transform: translateX(-50%); background: #111827; color: #e5e7eb; font-size: 0.7rem; font-family: ui-sans-serif,system-ui,sans-serif; font-style: normal; font-weight: normal; white-space: nowrap; padding: 2px 8px; border-radius: 4px; border: 1px solid #374151; pointer-events: none; opacity: 0; transition: opacity 0.08s; z-index: 100; }
  [data-tooltip]:hover::after { opacity: 1; }
</style>
    <!-- Content with live preview -->
    <div>
      <div class="flex items-center justify-between mb-1.5">
        <label for="content" class="block text-sm font-medium text-gray-400">Content</label>
        <div class="flex items-center gap-1.5">
          <!-- Content mode: Text | Draw -->
          <div class="flex gap-0.5 p-0.5 bg-gray-800 rounded-md">
            <button type="button" id="btn-mode-text"
                    class="px-2.5 py-1 rounded text-xs font-medium transition-colors bg-gray-700 text-gray-200"
                    onclick="setContentMode('text')">Text</button>
            <button type="button" id="btn-mode-draw"
                    class="px-2.5 py-1 rounded text-xs font-medium transition-colors text-gray-500 hover:text-gray-300"
                    onclick="setContentMode('draw')">✏ Draw</button>
          </div>
          <!-- Write/Preview (text mode only) -->
          <div id="write-preview-toggle" class="flex gap-0.5 p-0.5 bg-gray-800 rounded-md">
            <button type="button" id="btn-write"
                    class="px-2.5 py-1 rounded text-xs font-medium transition-colors bg-gray-700 text-gray-200"
                    onclick="setMode('write')">Write</button>
            <button type="button" id="btn-preview"
                    class="px-2.5 py-1 rounded text-xs font-medium transition-colors text-gray-500 hover:text-gray-300"
                    onclick="setMode('preview')">Preview</button>
          </div>
        </div>
      </div>

      <div id="write-panel">
        <!-- Toolbar -->
        <div id="md-toolbar" class="flex flex-wrap items-center gap-0.5 px-2 py-1.5 bg-gray-800 border border-gray-700 border-b-gray-700/50 rounded-t-lg">

          <!-- Heading dropdown -->
          <div class="relative" id="heading-menu-wrap">
            <button type="button" onclick="toggleHeadingMenu()" data-tooltip="Heading"
                    class="flex items-center gap-0.5 px-2 py-1 rounded text-xs font-semibold text-gray-400 hover:bg-gray-700 hover:text-gray-200 transition-colors">
              H<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-2.5 h-2.5 mt-0.5"><path d="M8 11L3 6h10L8 11z"/></svg>
            </button>
            <div id="heading-menu" class="hidden absolute top-full left-0 mt-1 bg-gray-900 border border-gray-700 rounded-lg shadow-xl z-50 py-1 min-w-[90px]">
              <button type="button" onclick="fmt('h1')" class="w-full text-left px-3 py-1.5 text-sm font-bold text-gray-200 hover:bg-gray-800 transition-colors">H1</button>
              <button type="button" onclick="fmt('h2')" class="w-full text-left px-3 py-1.5 text-sm font-semibold text-gray-200 hover:bg-gray-800 transition-colors">H2</button>
              <button type="button" onclick="fmt('h3')" class="w-full text-left px-3 py-1.5 text-sm text-gray-200 hover:bg-gray-800 transition-colors">H3</button>
            </div>
          </div>

          <div class="w-px h-4 bg-gray-600 mx-0.5"></div>

          <button type="button" onclick="fmt('bold')" data-tooltip="Bold (Ctrl+B)"
                  class="px-2 py-1 rounded text-sm font-bold text-gray-400 hover:bg-gray-700 hover:text-gray-200 transition-colors">B</button>
          <button type="button" onclick="fmt('italic')" data-tooltip="Italic (Ctrl+I)"
                  class="px-2 py-1 rounded text-sm italic text-gray-400 hover:bg-gray-700 hover:text-gray-200 transition-colors font-serif">I</button>
          <button type="button" onclick="fmt('underline')" data-tooltip="Underline"
                  class="px-2 py-1 rounded text-sm text-gray-400 hover:bg-gray-700 hover:text-gray-200 transition-colors underline">U</button>
          <button type="button" onclick="fmt('strike')" data-tooltip="Strikethrough"
                  class="px-2 py-1 rounded text-sm text-gray-400 hover:bg-gray-700 hover:text-gray-200 transition-colors line-through">S</button>

          <div class="w-px h-4 bg-gray-600 mx-0.5"></div>

          <!-- Lists -->
          <button type="button" onclick="fmt('ul')" data-tooltip="Bullet list"
                  class="px-1.5 py-1 rounded text-gray-400 hover:bg-gray-700 hover:text-gray-200 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
              <path fill-rule="evenodd" d="M6 4.75A.75.75 0 016.75 4h10.5a.75.75 0 010 1.5H6.75A.75.75 0 016 4.75zM6 10a.75.75 0 01.75-.75h10.5a.75.75 0 010 1.5H6.75A.75.75 0 016 10zm0 5.25a.75.75 0 01.75-.75h10.5a.75.75 0 010 1.5H6.75a.75.75 0 01-.75-.75zM2.5 4a1 1 0 100 2 1 1 0 000-2zm0 5.25a1 1 0 100 2 1 1 0 000-2zm0 5.25a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd"/>
            </svg>
          </button>
          <button type="button" onclick="fmt('ol')" data-tooltip="Numbered list"
                  class="px-1.5 py-1 rounded text-gray-400 hover:bg-gray-700 hover:text-gray-200 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
              <path fill-rule="evenodd" d="M4 2a.75.75 0 01.75.75V6.5h.75a.75.75 0 010 1.5H2.75a.75.75 0 010-1.5h.5V3.566l-.343.223a.75.75 0 01-.814-1.258L3 2.085A.75.75 0 014 2zm-1 9.5a.75.75 0 000 1.5h.31l-.14.28a.75.75 0 101.341.671l.697-1.393A.75.75 0 004.5 11.5H3zm3.25-6.75A.75.75 0 017 4h10.5a.75.75 0 010 1.5H7A.75.75 0 016.25 4.75zm0 5.25A.75.75 0 017 9.25h10.5a.75.75 0 010 1.5H7A.75.75 0 016.25 10zm0 5.25A.75.75 0 017 14.5h10.5a.75.75 0 010 1.5H7a.75.75 0 01-.75-.75z" clip-rule="evenodd"/>
            </svg>
          </button>
          <button type="button" onclick="fmt('checklist')" data-tooltip="Checklist"
                  class="px-1.5 py-1 rounded text-gray-400 hover:bg-gray-700 hover:text-gray-200 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
              <path fill-rule="evenodd" d="M2.5 3A1.5 1.5 0 001 4.5v4A1.5 1.5 0 002.5 10h6A1.5 1.5 0 0010 8.5v-4A1.5 1.5 0 008.5 3h-6zm11 2a.75.75 0 000 1.5h5a.75.75 0 000-1.5h-5zm0 4a.75.75 0 000 1.5h5a.75.75 0 000-1.5h-5zM3 13.75a.75.75 0 01.75-.75h.5a.75.75 0 010 1.5h-.5a.75.75 0 01-.75-.75zm.75 1.75a.75.75 0 000 1.5h.5a.75.75 0 000-1.5h-.5zM2.5 13A1.5 1.5 0 001 14.5v1A1.5 1.5 0 002.5 17h6a1.5 1.5 0 001.5-1.5v-1A1.5 1.5 0 008.5 13h-6zm11 1.75a.75.75 0 000 1.5h5a.75.75 0 000-1.5h-5zm0-1.75a.75.75 0 000 1.5h5a.75.75 0 000-1.5h-5z" clip-rule="evenodd"/>
            </svg>
          </button>
          <button type="button" onclick="fmt('quote')" data-tooltip="Blockquote"
                  class="px-1.5 py-1 rounded text-gray-400 hover:bg-gray-700 hover:text-gray-200 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
              <path fill-rule="evenodd" d="M10 3c-4.31 0-8 3.033-8 7 0 2.024.978 3.825 2.499 5.085a3.478 3.478 0 01-.522 1.756.75.75 0 00.584 1.157 8.029 8.029 0 003.84-1.346A9.014 9.014 0 0010 17c4.31 0 8-3.033 8-7s-3.69-7-8-7z" clip-rule="evenodd"/>
            </svg>
          </button>

          <div class="w-px h-4 bg-gray-600 mx-0.5"></div>

          <!-- Code -->
          <button type="button" onclick="fmt('code')" data-tooltip="Inline code"
                  class="px-2 py-1 rounded text-xs font-mono text-gray-400 hover:bg-gray-700 hover:text-gray-200 transition-colors">&lt;/&gt;</button>
          <button type="button" onclick="fmt('codeblock')" data-tooltip="Code block"
                  class="px-2 py-1 rounded text-xs font-mono text-gray-400 hover:bg-gray-700 hover:text-gray-200 transition-colors">```</button>

          <div class="w-px h-4 bg-gray-600 mx-0.5"></div>

          <!-- Link -->
          <button type="button" onclick="fmt('link')" data-tooltip="Link"
                  class="px-1.5 py-1 rounded text-gray-400 hover:bg-gray-700 hover:text-gray-200 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
              <path d="M12.232 4.232a2.5 2.5 0 013.536 3.536l-1.225 1.224a.75.75 0 001.061 1.06l1.224-1.224a4 4 0 00-5.656-5.656l-3 3a4 4 0 00.225 5.865.75.75 0 00.977-1.138 2.5 2.5 0 01-.142-3.667l3-3z"/>
              <path d="M11.603 7.963a.75.75 0 00-.977 1.138 2.5 2.5 0 01.142 3.667l-3 3a2.5 2.5 0 01-3.536-3.536l1.225-1.224a.75.75 0 00-1.061-1.06l-1.224 1.224a4 4 0 105.656 5.656l3-3a4 4 0 00-.225-5.865z"/>
            </svg>
          </button>

          <!-- HR -->
          <button type="button" onclick="fmt('hr')" data-tooltip="Horizontal rule"
                  class="px-2 py-1 rounded text-gray-400 hover:bg-gray-700 hover:text-gray-200 transition-colors text-sm">—</button>

          <!-- Table -->
          <button type="button" onclick="fmt('table')" data-tooltip="Insert table"
                  class="px-1.5 py-1 rounded text-gray-400 hover:bg-gray-700 hover:text-gray-200 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" class="w-4 h-4">
              <rect x="2" y="2" width="16" height="16" rx="1.5"/>
              <line x1="2" y1="7.5" x2="18" y2="7.5"/>
              <line x1="9" y1="7.5" x2="9" y2="18"/>
            </svg>
          </button>
        </div>

        <textarea id="content" name="content" rows="16"
                  class="w-full px-3.5 py-3 rounded-b-lg bg-gray-800 border border-gray-700 border-t-0 text-gray-100 placeholder-gray-600 text-sm font-mono
                         focus:outline-hidden focus:ring-2 focus:ring-indigo-500 focus:border-transparent resize-y"
                  placeholder="Start writing... (Markdown supported)"><%= typeof editorText !== 'undefined' ? editorText : (note && note.content ? note.content : '') %></textarea>
      </div>

      <div id="preview-panel" class="hidden rounded-lg bg-gray-800 border border-gray-700 px-5 py-4 min-h-[200px]">
        <div id="preview-content" class="prose text-sm"></div>
      </div>

      <%- include("../partials/note-paper") %>
      <!-- ── Draw panel ──────────────────────────────────────────────── -->
      <div id="draw-panel" class="hidden" style="-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;">
        <!-- Sticky toolbar so it stays visible while scrolling the canvas -->
        <div class="sticky top-0 z-10 flex items-center flex-wrap gap-2 px-2.5 py-2 bg-gray-800 border border-gray-700 rounded-t-lg">
          <!-- Colors -->
          <div class="flex gap-1.5 items-center">
            <button type="button" class="color-btn w-6 h-6 rounded-full shrink-0"
                    style="background:#f1f5f9;outline:2px solid #6366f1;outline-offset:1px"
                    data-color="#f1f5f9" title="White" onclick="selectColor('#f1f5f9')"></button>
            <button type="button" class="color-btn w-6 h-6 rounded-full shrink-0"
                    style="background:#93c5fd"
                    data-color="#93c5fd" title="Blue" onclick="selectColor('#93c5fd')"></button>
            <button type="button" class="color-btn w-6 h-6 rounded-full shrink-0"
                    style="background:#fca5a5"
                    data-color="#fca5a5" title="Red" onclick="selectColor('#fca5a5')"></button>
            <button type="button" class="color-btn w-6 h-6 rounded-full shrink-0"
                    style="background:#86efac"
                    data-color="#86efac" title="Green" onclick="selectColor('#86efac')"></button>
          </div>
          <div class="w-px h-4 bg-gray-600 shrink-0"></div>
          <!-- Sizes -->
          <div class="flex gap-0.5">
            <button type="button" class="size-btn px-2 py-1 rounded text-xs text-gray-400 hover:bg-gray-700 transition-colors"
                    data-size="1.5" title="Fine" onclick="selectSize('1.5')">S</button>
            <button type="button" class="size-btn px-2 py-1 rounded text-xs bg-gray-700 text-gray-200 transition-colors font-medium"
                    data-size="3" title="Medium" onclick="selectSize('3')">M</button>
            <button type="button" class="size-btn px-2 py-1 rounded text-xs text-gray-400 hover:bg-gray-700 transition-colors"
                    data-size="6" title="Thick" onclick="selectSize('6')">L</button>
          </div>
          <div class="w-px h-4 bg-gray-600 shrink-0"></div>
          <!-- Eraser -->
          <button type="button" id="eraserBtn"
                  class="px-2 py-1 rounded text-xs text-gray-400 hover:bg-gray-700 transition-colors flex items-center gap-1"
                  title="Eraser" onclick="toggleEraser()">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-3.5 h-3.5 shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636"/>
            </svg>
            Eraser
          </button>
          <div class="w-px h-4 bg-gray-600 shrink-0"></div>
          <button type="button" id="undoBtn"
                  class="px-2 py-1 rounded text-xs text-gray-400 hover:bg-gray-700 transition-colors"
                  title="Undo (⌘Z)" onclick="undo()">↩ Undo</button>
          <button type="button" id="clearBtn"
                  class="px-2 py-1 rounded text-xs text-gray-400 hover:text-red-400 hover:bg-gray-700 transition-colors"
                  title="Clear all" onclick="clearCanvas()">✕ Clear</button>
        </div>
        <!-- Canvas -->
        <div id="canvas-wrapper"
             class="note-paper border border-t-0 border-gray-700 rounded-b-lg overflow-hidden">
          <canvas id="draw-canvas" style="touch-action:none;cursor:crosshair;display:block;-webkit-touch-callout:none;-webkit-user-select:none;user-select:none;"></canvas>
        </div>
      </div>

      <p id="content-hint" class="text-xs text-gray-600 mt-1.5">Markdown supported — use toolbar or type syntax directly</p>
    </div>
    <input type="hidden" name="drawingData" id="drawingDataInput" value="<%= note && note.drawingData ? note.drawingData : '' %>">
    <input type="hidden" name="noteMode" id="noteModeInput" value="<%= note && note.drawingData ? 'draw' : 'text' %>">
